#!/bin/bash
#PBS -N fsdiloco_syncer
#PBS -q regular-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] syncer failed at line $LINENO" >&2' ERR

: "${FS_DILOCO_SHARED_ROOT:?FS_DILOCO_SHARED_ROOT is required}"
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
DESCRIPTOR="$FS_DILOCO_SHARED_ROOT/control/run_descriptor.json"

source "$PROJECT_ROOT/scripts/miyabi/actor_identity.sh"
prepare_actor_identity "$DESCRIPTOR" "$PROJECT_ROOT" "$PYTHON_BIN"
cd "$PROJECT_ROOT"

exec "$PYTHON_BIN" -m fs_diloco.syncer \
  --config "$FS_DILOCO_RESOLVED_CONFIG" \
  --shared-root "$FS_DILOCO_SHARED_ROOT"
