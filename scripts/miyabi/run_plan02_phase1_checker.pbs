#!/bin/bash
#PBS -N fsdiloco_p1_check
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:01:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] Phase 1 completed checker failed at line $LINENO" >&2' ERR

: "${FS_DILOCO_SHARED_ROOT:?FS_DILOCO_SHARED_ROOT is required}"
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
STAMP="${STAMP:-$(date +%Y%m%d-%H%M%S)}"
OUTPUT="${OUTPUT:-$PROJECT_ROOT/reports/DOING/fsb_decoupled_diloco_plan_02/artifacts/${STAMP}_phase1-completed-checker_pass.json}"

cd "$PROJECT_ROOT"
"$PYTHON_BIN" scripts/miyabi/check_plan02_phase1.py \
  --run-root "$FS_DILOCO_SHARED_ROOT" \
  --mode phase1-completed \
  --output "$OUTPUT"
printf 'PLAN02_PHASE1_CHECKER_ARTIFACT=%s\n' "$OUTPUT"
