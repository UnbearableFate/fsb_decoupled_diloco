#!/bin/bash
#PBS -N fsdiloco_plan02_p1_tests
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:01:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] Phase 1 tests failed at line $LINENO" >&2' ERR

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
cd "$PROJECT_ROOT"

hostname
printf 'PBS_JOBID=%s\nPBS_NODEFILE=%s\n' "${PBS_JOBID:-}" "${PBS_NODEFILE:-}"
"$PYTHON_BIN" -m pytest -q tests/test_plan02_phase1_ha.py
"$PYTHON_BIN" -m pytest -q
