#!/bin/bash
#PBS -N fsdiloco_p2_matched_launch
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:00:20
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] Phase 2 matched launcher failed at line $LINENO" >&2' ERR

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
REPORT_ROOT="$PROJECT_ROOT/reports/DOING/fsb_decoupled_diloco_plan_02"
STAMP="${STAMP:-$(date +%Y%m%d-%H%M%S)}"
RUN_PREFIX="${RUN_PREFIX:-plan02_phase2_matched_${PBS_JOBID%%.*}}"
IDENTITY_ROOT="${TMPDIR:?TMPDIR is required}/plan02_p2_matched_identity"
RECEIPTS="$REPORT_ROOT/artifacts/${STAMP}_phase2-matched-launch_pass.json"
OUTPUT="$REPORT_ROOT/artifacts/${STAMP}_phase2-matched-performance_pass.json"
cd "$PROJECT_ROOT"

"$PYTHON_BIN" scripts/miyabi/capture_source_identity.py \
  --project-root "$PROJECT_ROOT" \
  --output-json "$IDENTITY_ROOT.json" \
  --output-env "$IDENTITY_ROOT.env"
source "$IDENTITY_ROOT.env"

dirty_args=()
if [[ "${ALLOW_DIRTY_SNAPSHOT:-0}" == "1" ]]; then
  dirty_args+=(--allow-dirty-snapshot)
fi
"$PYTHON_BIN" -m fs_diloco.tools.launch_phase2_matched \
  --config "$PROJECT_ROOT/configs/fs_diloco_tiny_ha_dynamic_acceptance.yaml" \
  --project-root "$PROJECT_ROOT" \
  --run-prefix "$RUN_PREFIX" \
  --launcher-job-id "${PBS_JOBID:-}" \
  --syncer-walltime "${SYNCER_WALLTIME:-00:02:30}" \
  --learner-walltime "${LEARNER_WALLTIME:-00:02:00}" \
  --checker-walltime "${CHECKER_WALLTIME:-00:00:20}" \
  --receipts "$RECEIPTS" \
  --output "$OUTPUT" \
  "${dirty_args[@]}"

printf 'PHASE2_MATCHED_RECEIPTS=%s\nPHASE2_MATCHED_OUTPUT=%s\n' "$RECEIPTS" "$OUTPUT"
