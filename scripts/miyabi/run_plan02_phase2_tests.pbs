#!/bin/bash
#PBS -N fsdiloco_plan02_p2_tests
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] Phase 2 tests failed at line $LINENO" >&2' ERR

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
TEST_TARGET="${TEST_TARGET:-tests/test_plan02_phase2_dynamic.py tests/test_plan02_phase2_review_remediation.py}"
cd "$PROJECT_ROOT"

hostname
printf 'PBS_JOBID=%s\nPBS_NODEFILE=%s\n' "${PBS_JOBID:-}" "${PBS_NODEFILE:-}"
printf 'PROJECT_ROOT=%s\nTEST_TARGET=%s\n' "$PROJECT_ROOT" "$TEST_TARGET"
module list 2>&1 | cat
"$PYTHON_BIN" -m pytest -q $TEST_TARGET
