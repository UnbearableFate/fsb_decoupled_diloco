#!/bin/bash
#PBS -N fsdiloco_lmeval
#PBS -q regular-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
trap 'echo "[ERROR] Failed at line $LINENO" >&2' ERR

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
DEFAULT_CHECKPOINT="$PROJECT_ROOT/runs/fs_diloco/20260709_142811_fs_diloco_gpt2_wikitext2_8l_5000steps/weights/global_v000047.safetensors"
CHECKPOINT="${CHECKPOINT:-$DEFAULT_CHECKPOINT}"
RUN_ROOT="${RUN_ROOT:-}"
CONFIG="${CONFIG:-}"
TASK_SUITE="${TASK_SUITE:-full}"
FULL_TASKS="${FULL_TASKS:-wikitext,lambada_openai,hellaswag,piqa,arc_easy,arc_challenge,winogrande,openbookqa}"
SMOKE_TASKS="${SMOKE_TASKS:-wikitext,lambada_openai,hellaswag}"
TASKS="${TASKS:-}"
EVAL_LIMIT="${EVAL_LIMIT:-}"
BATCH_SIZE="${BATCH_SIZE:-auto}"
MODEL_DTYPE="${MODEL_DTYPE:-bfloat16}"
CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
EVAL_ID="${EVAL_ID:-$(date +%Y%m%d_%H%M%S)_lm_eval_fs_diloco}"
CACHE_ROOT="${CACHE_ROOT:-$PROJECT_ROOT/.cache/fs_diloco}"
HF_HOME="${HF_HOME:-$CACHE_ROOT/huggingface}"
HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$HF_HOME/datasets}"
HF_HUB_CACHE="${HF_HUB_CACHE:-$HF_HOME/hub}"
LM_HARNESS_CACHE_PATH="${LM_HARNESS_CACHE_PATH:-$CACHE_ROOT/lm_eval}"
TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-false}"

cd "$PROJECT_ROOT"

case "$TASK_SUITE" in
  full)
    TASKS="${TASKS:-$FULL_TASKS}"
    ;;
  smoke)
    TASKS="${TASKS:-$SMOKE_TASKS}"
    ;;
  *)
    if [[ -z "$TASKS" ]]; then
      echo "Unknown TASK_SUITE=$TASK_SUITE and TASKS is empty" >&2
      exit 2
    fi
    ;;
esac
TASKS="${TASKS//:/,}"
TASKS="${TASKS// /,}"

EVAL_DIR="$PROJECT_ROOT/runs/lm_eval/$EVAL_ID"
EXPORT_DIR="$EVAL_DIR/hf_checkpoint"
LMEVAL_OUTPUT_DIR="$EVAL_DIR/lm_eval_output"
MANIFEST="$EVAL_DIR/manifest.json"
METRICS_CSV="$EVAL_DIR/metrics.csv"
JOB_LOG="$EVAL_DIR/job.log"
LOG_ROOT="$PROJECT_ROOT/logs/qsub_${EVAL_ID}"

mkdir -p \
  "$EVAL_DIR" \
  "$LMEVAL_OUTPUT_DIR" \
  "$LOG_ROOT" \
  "$HF_DATASETS_CACHE" \
  "$HF_HUB_CACHE" \
  "$LM_HARNESS_CACHE_PATH"

exec > >(tee -a "$JOB_LOG") 2>&1

HOST="$(hostname)"
if [[ "$HOST" == miyabi-g* || "$HOST" == interact-g* ]]; then
  echo "Refusing to run lm-eval runtime on login/control host: $HOST" >&2
  exit 2
fi

echo "EVAL_ID=$EVAL_ID"
echo "HOST=$HOST"
echo "PROJECT_ROOT=$PROJECT_ROOT"
echo "PYTHON_BIN=$PYTHON_BIN"
echo "CHECKPOINT=$CHECKPOINT"
echo "RUN_ROOT=$RUN_ROOT"
echo "CONFIG=$CONFIG"
echo "TASK_SUITE=$TASK_SUITE"
echo "TASKS=$TASKS"
echo "EVAL_LIMIT=$EVAL_LIMIT"
echo "BATCH_SIZE=$BATCH_SIZE"
echo "MODEL_DTYPE=$MODEL_DTYPE"
echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
echo "HF_HOME=$HF_HOME"
echo "HF_DATASETS_CACHE=$HF_DATASETS_CACHE"
echo "HF_HUB_CACHE=$HF_HUB_CACHE"
echo "LM_HARNESS_CACHE_PATH=$LM_HARNESS_CACHE_PATH"
echo "EVAL_DIR=$EVAL_DIR"
echo "EXPORT_DIR=$EXPORT_DIR"
echo "LMEVAL_OUTPUT_DIR=$LMEVAL_OUTPUT_DIR"
echo "METRICS_CSV=$METRICS_CSV"
echo "JOB_LOG=$JOB_LOG"

if command -v nvidia-smi >/dev/null 2>&1; then
  nvidia-smi || true
fi

ensure_python() {
  if [[ -x "$PYTHON_BIN" ]]; then
    return
  fi
  if ! command -v uv >/dev/null 2>&1; then
    echo "Python executable not found and uv is unavailable: $PYTHON_BIN" >&2
    exit 2
  fi
  echo "Python executable not found; running uv sync --extra eval --no-dev"
  uv sync --extra eval --no-dev
}

ensure_lm_eval() {
  if "$PYTHON_BIN" -m lm_eval --help >/dev/null 2>&1; then
    return
  fi
  if ! command -v uv >/dev/null 2>&1; then
    echo "lm_eval is unavailable and uv is unavailable for installation" >&2
    exit 2
  fi
  echo "lm_eval is unavailable; running uv sync --extra eval --no-dev"
  uv sync --extra eval --no-dev
  "$PYTHON_BIN" -m lm_eval --help >/dev/null
}

ensure_python
ensure_lm_eval

export CUDA_VISIBLE_DEVICES
export HF_HOME
export HF_DATASETS_CACHE
export HF_HUB_CACHE
export LM_HARNESS_CACHE_PATH
export TOKENIZERS_PARALLELISM

EXPORT_ARGS=(
  -m fs_diloco.eval_lm_harness
  export-checkpoint
  --project-root "$PROJECT_ROOT"
  --eval-id "$EVAL_ID"
  --export-dir "$EXPORT_DIR"
  --manifest-output "$MANIFEST"
)
if [[ -n "$CHECKPOINT" ]]; then
  EXPORT_ARGS+=(--checkpoint "$CHECKPOINT")
fi
if [[ -n "$RUN_ROOT" ]]; then
  EXPORT_ARGS+=(--run-root "$RUN_ROOT")
fi
if [[ -n "$CONFIG" ]]; then
  EXPORT_ARGS+=(--config "$CONFIG")
fi

echo "[stage] export checkpoint"
"$PYTHON_BIN" "${EXPORT_ARGS[@]}" | tee "$LOG_ROOT/export_manifest.json"

LMEVAL_ARGS=(
  -m lm_eval
  --model hf
  --model_args "pretrained=$EXPORT_DIR,dtype=$MODEL_DTYPE"
  --tasks "$TASKS"
  --device cuda:0
  --batch_size "$BATCH_SIZE"
  --output_path "$LMEVAL_OUTPUT_DIR"
)
if [[ -n "$EVAL_LIMIT" ]]; then
  LMEVAL_ARGS+=(--limit "$EVAL_LIMIT")
fi

echo "[stage] lm-eval inference"
"$PYTHON_BIN" "${LMEVAL_ARGS[@]}" 2>&1 | tee "$LOG_ROOT/lm_eval.log"

echo "[stage] results to csv"
"$PYTHON_BIN" -m fs_diloco.eval_lm_harness results-to-csv \
  --lm-eval-output "$LMEVAL_OUTPUT_DIR" \
  --output-csv "$METRICS_CSV" \
  --eval-id "$EVAL_ID" \
  --manifest "$MANIFEST" | tee "$LOG_ROOT/results_to_csv.json"

echo "[stage] metrics preview"
sed -n '1,40p' "$METRICS_CSV"
echo "[done] $METRICS_CSV"
