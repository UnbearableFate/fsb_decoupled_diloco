#!/bin/bash
#PBS -N fsdiloco_p6_g8_static
#PBS -q regular-g
#PBS -W group_list=xg24i002
#PBS -l select=9:mpiprocs=1
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
trap 'echo "[ERROR] P6 G8 static failed at line $LINENO" >&2' ERR

: "${EVIDENCE_OUTPUT:?EVIDENCE_OUTPUT is required}"
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PRIMARY_WORKTREE_ROOT="${PRIMARY_WORKTREE_ROOT:-/work/xg24i002/x10041/fsb_decoupled_diloco}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
CONFIG="${CONFIG:-$PROJECT_ROOT/configs/fs_diloco_tiny_ha_static_acceptance.yaml}"
RUN_ID="${RUN_ID:-plan03_p6_g8_static_${PBS_JOBID%%.*}}"
SHARED_ROOT="${SHARED_ROOT:-$PRIMARY_WORKTREE_ROOT/runs/fs_diloco/$RUN_ID}"
LOG_ROOT="${LOG_ROOT:-$PRIMARY_WORKTREE_ROOT/logs/qsub_${RUN_ID}}"
EXPECTED_NODES=9
NUM_LEARNERS=8
COLOCATE_SYNCER=0
SYNCER_CUDA_VISIBLE_DEVICES=0
LEARNER_CUDA_VISIBLE_DEVICES=0

export PROJECT_ROOT PRIMARY_WORKTREE_ROOT PYTHON_BIN CONFIG RUN_ID SHARED_ROOT LOG_ROOT
export EXPECTED_NODES NUM_LEARNERS COLOCATE_SYNCER
export SYNCER_CUDA_VISIBLE_DEVICES LEARNER_CUDA_VISIBLE_DEVICES

bash "$PROJECT_ROOT/scripts/miyabi/run_v4_allocation.sh"
"$PYTHON_BIN" "$PROJECT_ROOT/scripts/miyabi/plan03_p6_validate_run.py" \
  --project-root "$PROJECT_ROOT" \
  --run-root "$SHARED_ROOT" \
  --mode static \
  --minimum-versions 20 \
  --minimum-inner-steps 60 \
  --expected-contributors 8 \
  --output "$EVIDENCE_OUTPUT"
printf 'PLAN03_P6_G8_STATIC_COMPLETE=%s\n' "${PBS_JOBID:-unknown}"
