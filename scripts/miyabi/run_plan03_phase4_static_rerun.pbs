#!/bin/bash
#PBS -N fsdiloco_p4_static_rerun
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] Failed at line $LINENO" >&2' ERR
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
export CUDA_VISIBLE_DEVICES=""
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
RUNS_ROOT="${RUNS_ROOT:-$PROJECT_ROOT/runs/fs_diloco}"
RUN_ID="${RUN_ID:-plan03_p4_static_rerun_${PBS_JOBID%%.*}}"
RUN_ROOT="$RUNS_ROOT/$RUN_ID"
LOG_ROOT="${LOG_ROOT:-$PROJECT_ROOT/logs/qsub_${RUN_ID}}"
TMP_ROOT="${TMPDIR:?TMPDIR is required}"
TEST_CONFIG="$TMP_ROOT/${RUN_ID}.yaml"
OLD_SIGNAL="$TMP_ROOT/${RUN_ID}_old_admission.json"
DUPLICATE_SIGNAL="$TMP_ROOT/${RUN_ID}_duplicate_admission.json"
NEW_SIGNAL="$TMP_ROOT/${RUN_ID}_new_admission.json"
LOGICAL_LAUNCH_ID="static-rerun-${PBS_JOBID%%.*}"
OLD_ATTEMPT_ID="attempt-old-${PBS_JOBID%%.*}"
DUPLICATE_ATTEMPT_ID="attempt-duplicate-${PBS_JOBID%%.*}"
NEW_ATTEMPT_ID="attempt-new-${PBS_JOBID%%.*}"
mkdir -p "$LOG_ROOT"
cd "$PROJECT_ROOT"

readarray -t source_identity < <(
  "$PYTHON_BIN" - "$PROJECT_ROOT" <<'PY'
import sys
from pathlib import Path

sys.path.insert(0, str(Path(sys.argv[1]) / "scripts/miyabi"))
from capture_source_identity import capture

value = capture(Path(sys.argv[1]))
print(value["git_commit"])
print(int(value["git_dirty"]))
print(value["source_fingerprint"])
PY
)
export FS_DILOCO_GIT_COMMIT="${source_identity[0]}"
export FS_DILOCO_GIT_DIRTY="${source_identity[1]}"
export FS_DILOCO_SOURCE_FINGERPRINT="${source_identity[2]}"
export FS_DILOCO_REQUIRE_SOURCE_IDENTITY=1

"$PYTHON_BIN" - configs/fs_diloco_tiny_ha_static.yaml "$TEST_CONFIG" <<'PY'
from pathlib import Path
import sys
import yaml

source, target = map(Path, sys.argv[1:])
config = yaml.safe_load(source.read_text(encoding="utf-8"))
config["sync"].update(
    num_learners=1,
    quorum_min=1,
    quorum_max=1,
    stop_after_outer_steps=20,
)
config["training"]["completion_mode"] = "global_only"
target.write_text(yaml.safe_dump(config, sort_keys=False), encoding="utf-8")
PY

"$PYTHON_BIN" -m fs_diloco.tools.init_run \
  --config "$TEST_CONFIG" \
  --run-id "$RUN_ID" \
  --shared-root "$RUN_ROOT" \
  --project-root "$PROJECT_ROOT" \
  --allow-dirty-snapshot \
  > "$LOG_ROOT/init_run.json"
readarray -t descriptor_fields < <(
  "$PYTHON_BIN" - "$LOG_ROOT/init_run.json" <<'PY'
import json
import sys

descriptor = json.load(open(sys.argv[1], encoding="utf-8"))["descriptor"]
print(descriptor["resolved_config_path"])
print(descriptor["descriptor_sha256"])
PY
)
CONFIG="${descriptor_fields[0]}"
export FS_DILOCO_EXPECTED_DESCRIPTOR_SHA256="${descriptor_fields[1]}"
export FS_DILOCO_EXPECTED_GIT_COMMIT="$FS_DILOCO_GIT_COMMIT"
export FS_DILOCO_EXPECTED_SOURCE_FINGERPRINT="$FS_DILOCO_SOURCE_FINGERPRINT"

syncer_pid=""
old_pid=""
duplicate_pid=""
new_pid=""
cleanup() {
  kill -CONT "$old_pid" 2>/dev/null || true
  kill "$syncer_pid" "$old_pid" "$duplicate_pid" "$new_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

"$PYTHON_BIN" -m fs_diloco.syncer \
  --config "$CONFIG" --shared-root "$RUN_ROOT" \
  > "$LOG_ROOT/syncer.log" 2>&1 &
syncer_pid=$!
FS_DILOCO_TEST_ADMISSION_SIGNAL_PATH="$OLD_SIGNAL" \
  "$PYTHON_BIN" -m fs_diloco.learner \
    --config "$CONFIG" --shared-root "$RUN_ROOT" \
    --learner-id learner_000 \
    --logical-launch-id "$LOGICAL_LAUNCH_ID" \
    --attempt-id "$OLD_ATTEMPT_ID" \
    > "$LOG_ROOT/learner_old.log" 2>&1 &
old_pid=$!

old_ready=false
for _ in $(seq 1 6000); do
  if [[ -f "$OLD_SIGNAL" ]]; then
    old_ready=true
    break
  fi
  if ! kill -0 "$old_pid" 2>/dev/null; then
    old_status=0
    wait "$old_pid" || old_status=$?
    old_pid=""
    tail -n 160 "$LOG_ROOT/learner_old.log" >&2 || true
    echo "Old learner exited before admission: status=$old_status" >&2
    exit 1
  fi
  sleep 0.01
done
if [[ "$old_ready" != true ]]; then
  echo "Old learner admission signal timed out" >&2
  exit 1
fi
kill -STOP "$old_pid"

FS_DILOCO_TEST_ADMISSION_SIGNAL_PATH="$DUPLICATE_SIGNAL" \
  "$PYTHON_BIN" -m fs_diloco.learner \
    --config "$CONFIG" --shared-root "$RUN_ROOT" \
    --learner-id learner_000 \
    --logical-launch-id "$LOGICAL_LAUNCH_ID" \
    --attempt-id "$DUPLICATE_ATTEMPT_ID" \
    > "$LOG_ROOT/learner_unauthorized_duplicate.log" 2>&1 &
duplicate_pid=$!

duplicate_exited=false
duplicate_status=0
for _ in $(seq 1 6000); do
  if ! kill -0 "$duplicate_pid" 2>/dev/null; then
    wait "$duplicate_pid" || duplicate_status=$?
    duplicate_pid=""
    duplicate_exited=true
    break
  fi
  sleep 0.01
done
if [[ "$duplicate_exited" != true ]]; then
  echo "Unauthorized duplicate did not receive a prompt rejection" >&2
  exit 1
fi
if [[ "$duplicate_status" -eq 0 ]]; then
  echo "Unauthorized duplicate unexpectedly exited successfully" >&2
  exit 1
fi
if [[ -e "$DUPLICATE_SIGNAL" ]]; then
  echo "Unauthorized duplicate crossed the post-revalidation pre-torch admission signal" >&2
  exit 1
fi
if ! rg -q 'AdmissionRejectedError.*active static replacement requires' \
  "$LOG_ROOT/learner_unauthorized_duplicate.log"; then
  tail -n 160 "$LOG_ROOT/learner_unauthorized_duplicate.log" >&2 || true
  echo "Unauthorized duplicate did not fail at the active-binding gate" >&2
  exit 1
fi
"$PYTHON_BIN" - "$RUN_ROOT" "$OLD_ATTEMPT_ID" <<'PY'
from pathlib import Path
import sqlite3
import sys

root, old_attempt = Path(sys.argv[1]), sys.argv[2]
connection = sqlite3.connect(root / "control/syncer_metadata.sqlite3")
connection.row_factory = sqlite3.Row
try:
    current = connection.execute(
        "SELECT * FROM static_contributor_bindings WHERE learner_id='learner_000'"
    ).fetchone()
    assert current is not None
    assert current["attempt_id"] == old_attempt
    assert current["binding_generation"] == 1
    assert current["status"] == "active"
finally:
    connection.close()
PY

"$PYTHON_BIN" -m fs_diloco.tools.authorize_static_replacement \
  --shared-root "$RUN_ROOT" \
  --run-id "$RUN_ID" \
  --descriptor-sha256 "$FS_DILOCO_EXPECTED_DESCRIPTOR_SHA256" \
  --learner-id learner_000 \
  --old-logical-launch-id "$LOGICAL_LAUNCH_ID" \
  --old-attempt-id "$OLD_ATTEMPT_ID" \
  --old-binding-generation 1 \
  --new-logical-launch-id "$LOGICAL_LAUNCH_ID" \
  --new-attempt-id "$NEW_ATTEMPT_ID" \
  --reason "operator-authorized static rerun after exact old process suspension" \
  > "$LOG_ROOT/static_replacement_authorization.json"

FS_DILOCO_TEST_ADMISSION_SIGNAL_PATH="$NEW_SIGNAL" \
  "$PYTHON_BIN" -m fs_diloco.learner \
    --config "$CONFIG" --shared-root "$RUN_ROOT" \
    --learner-id learner_000 \
    --logical-launch-id "$LOGICAL_LAUNCH_ID" \
    --attempt-id "$NEW_ATTEMPT_ID" \
    > "$LOG_ROOT/learner_new.log" 2>&1 &
new_pid=$!

new_ready=false
for _ in $(seq 1 6000); do
  if [[ -f "$NEW_SIGNAL" ]]; then
    new_ready=true
    break
  fi
  if ! kill -0 "$new_pid" 2>/dev/null; then
    new_status=0
    wait "$new_pid" || new_status=$?
    new_pid=""
    tail -n 160 "$LOG_ROOT/learner_new.log" >&2 || true
    echo "Replacement learner exited before admission: status=$new_status" >&2
    exit 1
  fi
  sleep 0.01
done
if [[ "$new_ready" != true ]]; then
  echo "Replacement learner admission signal timed out" >&2
  exit 1
fi

"$PYTHON_BIN" - "$RUN_ROOT" "$OLD_ATTEMPT_ID" "$NEW_ATTEMPT_ID" \
  "$LOG_ROOT/rerun_boundary.json" <<'PY'
import json
from pathlib import Path
import sqlite3
import sys

root, old_attempt, new_attempt, output = Path(sys.argv[1]), sys.argv[2], sys.argv[3], Path(sys.argv[4])
connection = sqlite3.connect(root / "control/syncer_metadata.sqlite3")
connection.row_factory = sqlite3.Row
try:
    current = connection.execute(
        "SELECT * FROM static_contributor_bindings WHERE learner_id='learner_000'"
    ).fetchone()
    history = connection.execute(
        "SELECT * FROM static_binding_history WHERE learner_id='learner_000' ORDER BY binding_generation"
    ).fetchall()
    version = connection.execute("SELECT MAX(version) FROM global_versions").fetchone()[0]
    assert current is not None
    assert current["attempt_id"] == new_attempt
    assert current["binding_generation"] == 2
    assert current["status"] == "active"
    assert len(history) == 1
    assert history[0]["attempt_id"] == old_attempt
    assert history[0]["final_status"] == "replaced"
    output.write_text(
        json.dumps(
            {
                "old_attempt_id": old_attempt,
                "new_attempt_id": new_attempt,
                "version_at_replacement": version,
            },
            sort_keys=True,
        ) + "\n",
        encoding="utf-8",
    )
finally:
    connection.close()
PY

kill -CONT "$old_pid"
wait "$new_pid"
new_pid=""
old_status=0
wait "$old_pid" || old_status=$?
old_pid=""
if [[ "$old_status" -ne 0 ]] && ! rg -q \
  'AdmissionSupersededError|immutable target collision|MembershipFenceError|stale fence|terminal' \
  "$LOG_ROOT/learner_old.log"; then
  tail -n 160 "$LOG_ROOT/learner_old.log" >&2 || true
  echo "Old learner failed for an unexpected reason: status=$old_status" >&2
  exit "$old_status"
fi
printf 'STALE_STATIC_LEARNER_STATUS=%s\n' "$old_status"
printf 'UNAUTHORIZED_DUPLICATE_STATUS=%s\n' "$duplicate_status"
wait "$syncer_pid"
syncer_pid=""
trap - EXIT INT TERM

"$PYTHON_BIN" - "$RUN_ROOT" "$LOG_ROOT/rerun_boundary.json" <<'PY'
import json
from pathlib import Path
import sqlite3
import sys

root, boundary_path = map(Path, sys.argv[1:])
boundary = json.loads(boundary_path.read_text(encoding="utf-8"))
connection = sqlite3.connect(root / "control/syncer_metadata.sqlite3")
connection.row_factory = sqlite3.Row
try:
    assert connection.execute("PRAGMA integrity_check").fetchone()[0] == "ok"
    binding = connection.execute(
        "SELECT * FROM static_contributor_bindings WHERE learner_id='learner_000'"
    ).fetchone()
    assert binding is not None
    assert binding["attempt_id"] == boundary["new_attempt_id"]
    assert binding["binding_generation"] == 2
    assert binding["status"] == "terminal"
    terminal = connection.execute("SELECT * FROM terminal_state").fetchone()
    assert terminal is not None and terminal["state"] == "finalized"
    applied = {}
    for row in connection.execute(
        "SELECT applied_version, fence_json FROM updates WHERE applied_version IS NOT NULL"
    ):
        attempt_id = json.loads(row["fence_json"])["attempt_id"]
        applied.setdefault(attempt_id, []).append(row["applied_version"])
    old_versions = applied.get(boundary["old_attempt_id"], [])
    assert all(version <= boundary["version_at_replacement"] for version in old_versions)
    new_versions = applied.get(boundary["new_attempt_id"], [])
    assert new_versions and max(new_versions) == terminal["final_version"]
    assert set(applied) <= {boundary["old_attempt_id"], boundary["new_attempt_id"]}
    fences = connection.execute(
        "SELECT state, hard_crash_gap_tokens_upper_bound FROM terminal_contributor_fences"
    ).fetchall()
    assert len(fences) == 1 and fences[0]["state"] == "acked"
    assert fences[0]["hard_crash_gap_tokens_upper_bound"] == 0
    progress = connection.execute(
        "SELECT * FROM contributor_progress WHERE stable_contributor_key='learner_000'"
    ).fetchone()
    assert progress is not None and progress["last_cycle_seq"] >= terminal["final_version"]
finally:
    connection.close()
summary = json.loads((root / "control/summary.json").read_text(encoding="utf-8"))
assert summary["all_learners_stopped"] is True
print(json.dumps({"boundary": boundary, "summary": summary}, sort_keys=True))
PY
printf 'PLAN03_PHASE4_STATIC_RERUN_COMPLETE=%s\n' "${PBS_JOBID:-unknown}"
