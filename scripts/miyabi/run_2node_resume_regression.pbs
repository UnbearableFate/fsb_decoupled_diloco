#!/bin/bash
#PBS -N fsdiloco_resume_2node
#PBS -q regular-g
#PBS -W group_list=xg24i002
#PBS -l select=2:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
trap 'echo "[ERROR] Failed at line $LINENO" >&2' ERR
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PRIMARY_WORKTREE_ROOT="${PRIMARY_WORKTREE_ROOT:-/work/xg24i002/x10041/fsb_decoupled_diloco}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
BASE_CONFIG="${BASE_CONFIG:-$PROJECT_ROOT/configs/fs_diloco_tiny_ha_static.yaml}"
RUN_ID="${RUN_ID:-$(date +%Y%m%d_%H%M%S)_fs_diloco_2node_resume}"
SHARED_ROOT="${SHARED_ROOT:-$PRIMARY_WORKTREE_ROOT/runs/fs_diloco/$RUN_ID}"
LOG_ROOT="${LOG_ROOT:-$PRIMARY_WORKTREE_ROOT/logs/qsub_${RUN_ID}}"
TEST_CONFIG="${TMPDIR:?TMPDIR is required}/${RUN_ID}.yaml"
: "${PBS_NODEFILE:?PBS_NODEFILE is required}"

cd "$PROJECT_ROOT"
mapfile -t HOSTS < <(sort -u "$PBS_NODEFILE")
test "${#HOSTS[@]}" -eq 2
mkdir -p "$LOG_ROOT"
"$PYTHON_BIN" "$PROJECT_ROOT/scripts/miyabi/capture_source_identity.py" \
  --project-root "$PROJECT_ROOT" \
  --output-json "$LOG_ROOT/source_identity.json" \
  --output-env "$LOG_ROOT/source_identity.env" \
  > "$LOG_ROOT/source_identity.log"
source "$LOG_ROOT/source_identity.env"

"$PYTHON_BIN" - "$BASE_CONFIG" "$TEST_CONFIG" <<'PY'
from pathlib import Path
import sys
import yaml

source, target = map(Path, sys.argv[1:])
config = yaml.safe_load(source.read_text(encoding="utf-8"))
config["sync"].update(
    num_learners=1,
    quorum_min=1,
    quorum_max=1,
    stop_after_outer_steps=20,
)
config["training"]["completion_mode"] = "global_only"
leader = config["coordination"]["leader"]
leader.update(
    lease_duration_seconds=5.0,
    renew_interval_seconds=1.0,
    max_clock_skew_seconds=0.2,
    heartbeat_interval_seconds=0.5,
    heartbeat_stale_after_seconds=2.0,
    lease_busy_timeout_ms=500,
    candidate_acquire_poll_seconds=0.2,
    candidate_wait_seconds=10.0,
    learner_recovery_wait_seconds=15.0,
)
target.write_text(yaml.safe_dump(config, sort_keys=False), encoding="utf-8")
PY

"$PYTHON_BIN" -m fs_diloco.tools.init_run \
  --config "$TEST_CONFIG" \
  --run-id "$RUN_ID" \
  --shared-root "$SHARED_ROOT" \
  --project-root "$PROJECT_ROOT" \
  --allow-dirty-snapshot \
  > "$LOG_ROOT/init_run.json"
readarray -t descriptor_fields < <(
  "$PYTHON_BIN" - "$LOG_ROOT/init_run.json" <<'PY'
import json
import sys

descriptor = json.load(open(sys.argv[1], encoding="utf-8"))["descriptor"]
print(descriptor["resolved_config_path"])
print(descriptor["descriptor_sha256"])
print(descriptor["git_commit"])
print(descriptor["source_fingerprint"])
print(int(bool(descriptor["git_dirty"])))
PY
)
CONFIG="${descriptor_fields[0]}"
export FS_DILOCO_EXPECTED_DESCRIPTOR_SHA256="${descriptor_fields[1]}"
export FS_DILOCO_EXPECTED_GIT_COMMIT="${descriptor_fields[2]}"
export FS_DILOCO_EXPECTED_SOURCE_FINGERPRINT="${descriptor_fields[3]}"
export FS_DILOCO_GIT_COMMIT="${descriptor_fields[2]}"
export FS_DILOCO_SOURCE_FINGERPRINT="${descriptor_fields[3]}"
export FS_DILOCO_GIT_DIRTY="${descriptor_fields[4]}"
export FS_DILOCO_REQUIRE_SOURCE_IDENTITY=1

first_pid=""
successor_pid=""
learner_pid=""
cleanup() {
  kill "$first_pid" "$successor_pid" "$learner_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

CUDA_VISIBLE_DEVICES="" "$PYTHON_BIN" -m fs_diloco.syncer \
  --config "$CONFIG" --shared-root "$SHARED_ROOT" \
  > "$LOG_ROOT/syncer_initial.log" 2>&1 &
first_pid=$!
CUDA_VISIBLE_DEVICES="" "$PYTHON_BIN" -m fs_diloco.learner \
  --config "$CONFIG" --shared-root "$SHARED_ROOT" \
  --learner-id learner_000 \
  --logical-launch-id "resume-${PBS_JOBID%%.*}-learner_000" \
  > "$LOG_ROOT/learner_000.log" 2>&1 &
learner_pid=$!

ready=false
for _ in $(seq 1 200); do
  if "$PYTHON_BIN" - "$SHARED_ROOT/control/syncer_metadata.sqlite3" <<'PY'
import sqlite3
import sys

connection = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
version = connection.execute("SELECT MAX(version) FROM global_versions").fetchone()[0]
raise SystemExit(0 if version is not None and int(version) >= 1 else 1)
PY
  then
    ready=true
    break
  fi
  sleep 0.05
done
if [[ "$ready" != true ]]; then
  echo "Initial candidate never committed v1" >&2
  exit 1
fi

kill -KILL "$first_pid"
first_status=0
wait "$first_pid" || first_status=$?
first_pid=""
test "$first_status" -eq 137

mpirun --bind-to none -np 1 --host "${HOSTS[1]}" \
  /usr/bin/env \
    "FS_DILOCO_EXPECTED_DESCRIPTOR_SHA256=$FS_DILOCO_EXPECTED_DESCRIPTOR_SHA256" \
    "FS_DILOCO_EXPECTED_GIT_COMMIT=$FS_DILOCO_EXPECTED_GIT_COMMIT" \
    "FS_DILOCO_EXPECTED_SOURCE_FINGERPRINT=$FS_DILOCO_EXPECTED_SOURCE_FINGERPRINT" \
    "FS_DILOCO_GIT_COMMIT=$FS_DILOCO_GIT_COMMIT" \
    "FS_DILOCO_SOURCE_FINGERPRINT=$FS_DILOCO_SOURCE_FINGERPRINT" \
    "FS_DILOCO_GIT_DIRTY=$FS_DILOCO_GIT_DIRTY" \
    "FS_DILOCO_REQUIRE_SOURCE_IDENTITY=1" \
    "CUDA_VISIBLE_DEVICES=" \
    "$PYTHON_BIN" -m fs_diloco.syncer \
      --config "$CONFIG" --shared-root "$SHARED_ROOT" \
      > "$LOG_ROOT/syncer_successor.log" 2>&1 &
successor_pid=$!
wait "$learner_pid"
learner_pid=""
wait "$successor_pid"
successor_pid=""
trap - EXIT INT TERM

"$PYTHON_BIN" - "$SHARED_ROOT" <<'PY'
import json
import sqlite3
import sys
from pathlib import Path

root = Path(sys.argv[1])
connection = sqlite3.connect(root / "control/syncer_metadata.sqlite3")
connection.row_factory = sqlite3.Row
try:
    assert connection.execute("PRAGMA integrity_check").fetchone()[0] == "ok"
    epochs = connection.execute(
        "SELECT epoch, owner_id, hostname, final_state FROM syncer_epochs ORDER BY epoch"
    ).fetchall()
    assert len(epochs) >= 2 and epochs[-1]["epoch"] > epochs[0]["epoch"]
    assert epochs[0]["final_state"] == "expired"
    assert epochs[-1]["final_state"] == "released"
    terminal = connection.execute("SELECT * FROM terminal_state").fetchone()
    assert terminal is not None and terminal["state"] == "finalized"
    assert terminal["final_version"] == 20
    versions = connection.execute(
        "SELECT version, committed_by_epoch FROM global_versions ORDER BY version"
    ).fetchall()
    assert [row["version"] for row in versions] == list(range(21))
    assert {row["committed_by_epoch"] for row in versions} >= {epochs[0]["epoch"], epochs[-1]["epoch"]}
    fences = connection.execute("SELECT state FROM terminal_contributor_fences").fetchall()
    assert [row["state"] for row in fences] == ["acked"]
finally:
    connection.close()
summary = json.loads((root / "control/summary.json").read_text(encoding="utf-8"))
assert summary["final_version"] == 20 and summary["all_learners_stopped"] is True
print(json.dumps({"run_root": str(root), "epochs": [dict(row) for row in epochs], "summary": summary}, sort_keys=True))
PY
printf 'PLAN03_PHASE4_TWO_CANDIDATE_TAKEOVER_COMPLETE=%s\n' "${PBS_JOBID:-unknown}"
