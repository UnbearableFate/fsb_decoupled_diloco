#!/bin/bash
#PBS -N fsdiloco_p6_g2
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] P6 G2 tests failed at line $LINENO" >&2' ERR
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
export CUDA_VISIBLE_DEVICES=""
export PYTHONDONTWRITEBYTECODE=1
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
: "${EVIDENCE_OUTPUT:?EVIDENCE_OUTPUT is required}"
LOG_ROOT="${LOG_ROOT:-$PROJECT_ROOT/logs/qsub_plan03_p6_g2_${PBS_JOBID%%.*}}"

cd "$PROJECT_ROOT"
"$PYTHON_BIN" scripts/miyabi/plan03_p6_test_gate.py \
  --mode compute \
  --project-root "$PROJECT_ROOT" \
  --python "$PYTHON_BIN" \
  --log-root "$LOG_ROOT" \
  --output "$EVIDENCE_OUTPUT"
