#!/bin/bash
#PBS -N fsdiloco_multi_review
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:30:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] multi-agent review orchestration failed at line $LINENO" >&2' ERR

export PAGER=cat
export MODULES_PAGER=cat
export LMOD_PAGER=cat
export NO_COLOR=1
export CUDA_VISIBLE_DEVICES=""
export GIT_OPTIONAL_LOCKS=0
export PYTHONDONTWRITEBYTECODE=1
export PATH="$HOME/.local/bin:$HOME/.opencode/bin:$HOME/.npm-global/bin:$PATH"

die() {
  echo "[ERROR] $*" >&2
  exit 2
}

require_safe_component() {
  local label="$1"
  local value="$2"
  [[ "$value" =~ ^[A-Za-z0-9._-]+$ ]] || die "$label contains unsafe characters: $value"
}

require_commit() {
  local label="$1"
  local value="$2"
  [[ "$value" =~ ^[0-9a-fA-F]{40}$ ]] || die "$label must be a full 40-character commit ID"
  git -C "$PROJECT_ROOT" cat-file -e "${value}^{commit}" || die "$label is not available: $value"
}

new_uuid() {
  if command -v uuidgen >/dev/null 2>&1; then
    uuidgen | tr '[:upper:]' '[:lower:]'
  elif [[ -r /proc/sys/kernel/random/uuid ]]; then
    tr '[:upper:]' '[:lower:]' </proc/sys/kernel/random/uuid
  else
    printf '%s-%s-%s\n' "${PBS_JOBID%%.*}" "$RANDOM" "$(date +%s)"
  fi
}

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-}}"
: "${PROJECT_ROOT:?PROJECT_ROOT or PBS_O_WORKDIR is required}"
: "${PLAN_ID:?PLAN_ID is required}"
: "${REVIEW_ID:?REVIEW_ID is required}"
: "${REVIEW_KIND:?REVIEW_KIND is required}"
: "${BASE_COMMIT:?BASE_COMMIT is required}"
: "${TARGET_COMMIT:?TARGET_COMMIT is required}"
if [[ -n "${REVIEW_PROMPT_FILE:-}" && -n "${REVIEW_PROMPT_B64:-}" ]]; then
  die "provide exactly one of REVIEW_PROMPT_FILE or REVIEW_PROMPT_B64"
fi
[[ -n "${REVIEW_PROMPT_FILE:-}" || -n "${REVIEW_PROMPT_B64:-}" ]] || \
  die "REVIEW_PROMPT_FILE or REVIEW_PROMPT_B64 is required"

PROJECT_ROOT="$(cd "$PROJECT_ROOT" && pwd -P)"
[[ "$PROJECT_ROOT" != *","* ]] || die "PROJECT_ROOT must not contain a comma"
REPORT_ROOT="$PROJECT_ROOT/reports/DOING/code_review"
CLAUDE_BIN="${CLAUDE_BIN:-claude}"
OPENCODE_BIN="${OPENCODE_BIN:-opencode}"
CLAUDE_MODEL="${CLAUDE_MODEL:-claude-opus-5}"
OPENCODE_GLM_MODEL="${OPENCODE_GLM_MODEL:-opencode-go/glm-5.2}"
OPENCODE_DEEPSEEK_MODEL="${OPENCODE_DEEPSEEK_MODEL:-opencode-go/deepseek-v4-flash}"
OPENCODE_KIMI_MODEL="${OPENCODE_KIMI_MODEL:-opencode-go/kimi-3}"
REVIEW_TIMEOUT_SECONDS="${REVIEW_TIMEOUT_SECONDS:-1500}"

HOST_NAME="$(hostname)"
[[ -n "${PBS_JOBID:-}" ]] || die "PBS_JOBID is missing; do not run reviewers outside PBS"
[[ "$HOST_NAME" =~ ^mg[0-9]+$ ]] || die "reviewers must run on an mg<number> compute node, got $HOST_NAME"
[[ "$REVIEW_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]] || die "REVIEW_TIMEOUT_SECONDS must be an integer"
((REVIEW_TIMEOUT_SECONDS >= 60 && REVIEW_TIMEOUT_SECONDS <= 1500)) || \
  die "REVIEW_TIMEOUT_SECONDS must be between 60 and 1500"

require_safe_component "PLAN_ID" "$PLAN_ID"
require_safe_component "REVIEW_ID" "$REVIEW_ID"
require_safe_component "REVIEW_KIND" "$REVIEW_KIND"
case "$REVIEW_KIND" in
  test-design | failure | phase | preformal-plan-complete | final-evidence | critical-incremental) ;;
  *) die "unsupported REVIEW_KIND: $REVIEW_KIND" ;;
esac
command -v git >/dev/null 2>&1 || die "git is required"
command -v python3 >/dev/null 2>&1 || die "python3 is required"
command -v timeout >/dev/null 2>&1 || die "GNU timeout is required"
command -v sha256sum >/dev/null 2>&1 || die "sha256sum is required"
command -v tar >/dev/null 2>&1 || die "tar is required"
require_commit "BASE_COMMIT" "$BASE_COMMIT"
require_commit "TARGET_COMMIT" "$TARGET_COMMIT"
git -C "$PROJECT_ROOT" merge-base --is-ancestor "$BASE_COMMIT" "$TARGET_COMMIT" || \
  die "BASE_COMMIT is not an ancestor of TARGET_COMMIT"

JOB_STEM="${PBS_JOBID%%.*}"
REPORT_DIR="$REPORT_ROOT/$PLAN_ID/$REVIEW_ID"
mkdir -p "$REPORT_DIR"

TASK_TMP_ROOT="${TMPDIR:-/tmp}"
RUN_TMP="$(mktemp -d "$TASK_TMP_ROOT/fsdiloco-review.${JOB_STEM}.XXXXXX")"
SNAPSHOT_CLAUDE="$RUN_TMP/repository-claude"
SNAPSHOT_GLM="$RUN_TMP/repository-glm"
SNAPSHOT_DEEPSEEK="$RUN_TMP/repository-deepseek"
SNAPSHOT_KIMI="$RUN_TMP/repository-kimi"

cleanup() {
  if [[ -n "${RUN_TMP:-}" && -d "$RUN_TMP" && "$RUN_TMP" == "$TASK_TMP_ROOT"/fsdiloco-review.* ]]; then
    chmod -R u+w -- "$RUN_TMP" 2>/dev/null || true
    rm -rf -- "$RUN_TMP"
  fi
}
trap cleanup EXIT

PROMPT_FILE="$RUN_TMP/common-review-prompt.md"
if [[ -n "${REVIEW_PROMPT_FILE:-}" ]]; then
  [[ "$REVIEW_PROMPT_FILE" != *","* ]] || die "REVIEW_PROMPT_FILE must not contain a comma"
  [[ -f "$REVIEW_PROMPT_FILE" && ! -L "$REVIEW_PROMPT_FILE" ]] || \
    die "REVIEW_PROMPT_FILE must be a regular non-symlink file"
  PROMPT_SOURCE_REAL="$(cd "$(dirname "$REVIEW_PROMPT_FILE")" && pwd -P)/$(basename "$REVIEW_PROMPT_FILE")"
  case "$PROMPT_SOURCE_REAL" in
    "$REPORT_ROOT"/*) ;;
    *) die "REVIEW_PROMPT_FILE must be under $REPORT_ROOT" ;;
  esac
  [[ "${REVIEW_PROMPT_SHA256:-}" =~ ^[0-9a-f]{64}$ ]] || \
    die "REVIEW_PROMPT_SHA256 must be a lowercase SHA-256 when using REVIEW_PROMPT_FILE"
  cp -- "$PROMPT_SOURCE_REAL" "$PROMPT_FILE"
elif command -v base64 >/dev/null 2>&1; then
  ((${#REVIEW_PROMPT_B64} <= 32768)) || \
    die "REVIEW_PROMPT_B64 fallback exceeds 32768 characters; use REVIEW_PROMPT_FILE"
  if ! printf '%s' "$REVIEW_PROMPT_B64" | base64 --decode >"$PROMPT_FILE"; then
    die "REVIEW_PROMPT_B64 is not valid base64"
  fi
else
  die "base64 is required for REVIEW_PROMPT_B64 fallback"
fi
[[ -s "$PROMPT_FILE" ]] || die "decoded review prompt is empty"
PROMPT_BYTES="$(wc -c <"$PROMPT_FILE")"
((PROMPT_BYTES <= 65536)) || die "review prompt exceeds 65536 bytes"
PROMPT_SHA256="$(sha256sum "$PROMPT_FILE" | awk '{print $1}')"
if [[ -n "${REVIEW_PROMPT_FILE:-}" && "$PROMPT_SHA256" != "$REVIEW_PROMPT_SHA256" ]]; then
  die "REVIEW_PROMPT_FILE SHA-256 does not match REVIEW_PROMPT_SHA256"
fi

PACKET_SOURCE="$RUN_TMP/review-packet"
mkdir -p "$PACKET_SOURCE"
git -C "$PROJECT_ROOT" diff --no-ext-diff --stat "$BASE_COMMIT" "$TARGET_COMMIT" \
  >"$PACKET_SOURCE/diff-stat.txt"
git -C "$PROJECT_ROOT" diff --no-ext-diff --name-status "$BASE_COMMIT" "$TARGET_COMMIT" \
  >"$PACKET_SOURCE/changed-files.txt"
git -C "$PROJECT_ROOT" diff --no-ext-diff --find-renames --find-copies "$BASE_COMMIT" "$TARGET_COMMIT" \
  >"$PACKET_SOURCE/target.diff"
TARGET_TREE="$(git -C "$PROJECT_ROOT" rev-parse "${TARGET_COMMIT}^{tree}")"
DIFF_SHA256="$(sha256sum "$PACKET_SOURCE/target.diff" | awk '{print $1}')"
TARGET_ARCHIVE="$RUN_TMP/target.tar"
git -C "$PROJECT_ROOT" archive --format=tar --output="$TARGET_ARCHIVE" "$TARGET_COMMIT"

snapshot_digest() {
  local snapshot_dir="$1"
  python3 - "$snapshot_dir" <<'PY'
import hashlib
import os
import pathlib
import stat
import sys

root = pathlib.Path(sys.argv[1])
digest = hashlib.sha256()
for path in sorted(root.rglob("*"), key=lambda item: item.relative_to(root).as_posix()):
    relative = path.relative_to(root).as_posix().encode("utf-8", "surrogateescape")
    metadata = path.lstat()
    digest.update(relative + b"\0" + oct(stat.S_IMODE(metadata.st_mode)).encode() + b"\0")
    if path.is_symlink():
        digest.update(b"L\0" + os.readlink(path).encode("utf-8", "surrogateescape") + b"\0")
    elif path.is_file():
        digest.update(b"F\0")
        with path.open("rb") as handle:
            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                digest.update(chunk)
        digest.update(b"\0")
    elif path.is_dir():
        digest.update(b"D\0")
    else:
        digest.update(b"O\0")
print(digest.hexdigest())
PY
}

prepare_snapshot() {
  local snapshot_dir="$1"
  mkdir -p "$snapshot_dir"
  tar -xf "$TARGET_ARCHIVE" -C "$snapshot_dir"
  mkdir -p "$snapshot_dir/.review-packet"
  cp "$PACKET_SOURCE/diff-stat.txt" "$snapshot_dir/.review-packet/diff-stat.txt"
  cp "$PACKET_SOURCE/changed-files.txt" "$snapshot_dir/.review-packet/changed-files.txt"
  cp "$PACKET_SOURCE/target.diff" "$snapshot_dir/.review-packet/target.diff"
  chmod -R a-w -- "$snapshot_dir"
}

prepare_snapshot "$SNAPSHOT_CLAUDE"
prepare_snapshot "$SNAPSHOT_GLM"
prepare_snapshot "$SNAPSHOT_DEEPSEEK"
prepare_snapshot "$SNAPSHOT_KIMI"
SNAPSHOT_CLAUDE_SHA256="$(snapshot_digest "$SNAPSHOT_CLAUDE")"
SNAPSHOT_GLM_SHA256="$(snapshot_digest "$SNAPSHOT_GLM")"
SNAPSHOT_DEEPSEEK_SHA256="$(snapshot_digest "$SNAPSHOT_DEEPSEEK")"
SNAPSHOT_KIMI_SHA256="$(snapshot_digest "$SNAPSHOT_KIMI")"

REQUEST_RECORD="$REPORT_DIR/review-request_${TARGET_COMMIT}_${JOB_STEM}.md"
REQUEST_RECORD_TMP="$RUN_TMP/review-request.md"
[[ ! -e "$REQUEST_RECORD" ]] || die "review request already exists: $REQUEST_RECORD"
{
  printf '# Multi-agent review request\n\n'
  printf -- '- Plan ID: `%s`\n' "$PLAN_ID"
  printf -- '- Review ID: `%s`\n' "$REVIEW_ID"
  printf -- '- Review kind: `%s`\n' "$REVIEW_KIND"
  printf -- '- Base commit: `%s`\n' "$BASE_COMMIT"
  printf -- '- Target commit: `%s`\n' "$TARGET_COMMIT"
  printf -- '- PBS job ID: `%s`\n' "$PBS_JOBID"
  printf -- '- Compute hostname: `%s`\n' "$HOST_NAME"
  printf -- '- Target tree: `%s`\n' "$TARGET_TREE"
  printf -- '- Target diff SHA-256: `%s`\n' "$DIFF_SHA256"
  printf -- '- Prompt SHA-256: `%s`\n\n' "$PROMPT_SHA256"
  printf '## Common prompt\n\n'
  cat "$PROMPT_FILE"
  printf '\n'
} >"$REQUEST_RECORD_TMP"
mv -- "$REQUEST_RECORD_TMP" "$REQUEST_RECORD"

reviewer_suffix() {
  local reviewer="$1"
  local model="$2"
  local lane="$3"
  printf '\n\n%s\n' '---'
  printf 'Reviewer identity: %s\n' "$reviewer"
  printf 'Requested model: %s\n' "$model"
  printf 'Primary review lane: %s\n' "$lane"
  printf 'Review the read-only target snapshot at %s; base is %s.\n' "$TARGET_COMMIT" "$BASE_COMMIT"
  printf '%s\n' 'The runner provides .review-packet/diff-stat.txt, changed-files.txt, and target.diff. This untracked packet is runner metadata outside the target and is not a product finding.'
  case "$REVIEW_KIND" in
    preformal-plan-complete)
      printf '%s\n' 'This is a current-state review. Inspect the complete target tree and do not limit the review to target.diff; the diff is continuity context only.'
      ;;
    final-evidence)
      printf '%s\n' 'This is a final evidence review. Validate experiment identity, durable oracles, requirement bindings, documentation, and cleanup; do not infer PASS from exit codes alone.'
      ;;
    *)
      printf '%s\n' 'Inspect the complete in-scope change and all directly affected callers, tests, configuration, launchers, Checkers, and documentation.'
      ;;
  esac
  printf '%s\n' 'Form conclusions independently. Do not inspect another reviewer output.'
  printf '%s\n' 'Do not modify files or Git state, submit/cancel jobs, write external state, or run expensive/full test suites.'
  printf '%s\n' 'Return only a complete Markdown review. Record scope, requested/actual model identity if available, and findings with severity/evidence/file lines/remediation/missing tests.'
  printf '%s\n' 'If no finding exists, list the files/modules and invariants actually inspected.'
  printf '%s\n' 'The final non-empty line must be exactly `Verdict: APPROVE` or `Verdict: CHANGES_REQUIRED`.'
}

validate_report() {
  local report_file="$1"
  local report_bytes
  local final_line
  [[ -s "$report_file" ]] || return 1
  report_bytes="$(wc -c <"$report_file")"
  ((report_bytes >= 200)) || return 1
  final_line="$(awk 'NF { line=$0 } END { sub(/\r$/, "", line); print line }' "$report_file")"
  [[ "$final_line" =~ ^Verdict:\ (APPROVE|CHANGES_REQUIRED)$ ]]
}

classify_failure() {
  local exit_code="$1"
  local stderr_file="$2"
  local raw_file="$3"
  if [[ "$exit_code" -eq 124 ]]; then
    printf 'timed-out\n'
  elif grep -Eiq 'session limit|rate.?limit|quota|insufficient[^[:alnum:]]+(balance|credit)|out of credits|billing limit' \
    "$stderr_file" "$raw_file" 2>/dev/null; then
    printf 'skipped-capacity\n'
  else
    printf 'failed-command\n'
  fi
}

write_result_tsv() {
  local file="$1"
  local reviewer="$2"
  local cli="$3"
  local requested_model="$4"
  local invocation_id="$5"
  local prompt_sha256="$6"
  local snapshot_before="$7"
  local snapshot_after="$8"
  local status="$9"
  local exit_code="${10}"
  local started_at="${11}"
  local ended_at="${12}"
  local report_file="${13}"
  local raw_file="${14}"
  local stderr_file="${15}"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$reviewer" "$cli" "$requested_model" "$invocation_id" "$prompt_sha256" \
    "$snapshot_before" "$snapshot_after" \
    "$status" "$exit_code" \
    "$started_at" "$ended_at" \
    "$report_file" "$raw_file" "$stderr_file" >"$file"
}

run_claude() {
  local reviewer="claude-opus-5"
  local lane="protocol correctness, architecture, and concurrency/persistence invariants"
  local report_file="$REPORT_DIR/${reviewer}_${TARGET_COMMIT}_${JOB_STEM}.md"
  local raw_file="$REPORT_DIR/${reviewer}_${TARGET_COMMIT}_${JOB_STEM}_raw.json"
  local stderr_file="$REPORT_DIR/${reviewer}_${TARGET_COMMIT}_${JOB_STEM}.stderr.log"
  local result_file="$RUN_TMP/${reviewer}.tsv"
  local parsed_report="$RUN_TMP/${reviewer}.md"
  local prompt
  local started_at
  local ended_at
  local exit_code=0
  local status
  local session_id
  local reviewer_prompt_sha256
  local snapshot_before="$SNAPSHOT_CLAUDE_SHA256"
  local snapshot_after="$SNAPSHOT_CLAUDE_SHA256"

  started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  session_id="$(new_uuid)"
  prompt="$(cat "$PROMPT_FILE")$(reviewer_suffix "$reviewer" "$CLAUDE_MODEL" "$lane")"
  reviewer_prompt_sha256="$(printf '%s' "$prompt" | sha256sum | awk '{print $1}')"
  if ! command -v "$CLAUDE_BIN" >/dev/null 2>&1; then
    ended_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    : >"$raw_file"
    printf 'Claude CLI not found: %s\n' "$CLAUDE_BIN" >"$stderr_file"
    write_result_tsv "$result_file" "$reviewer" "$CLAUDE_BIN" "$CLAUDE_MODEL" "$session_id" \
      "$reviewer_prompt_sha256" \
      "$snapshot_before" "$snapshot_after" \
      "skipped-tool-unavailable" 127 \
      "$started_at" "$ended_at" "$report_file" "$raw_file" "$stderr_file"
    return 0
  fi

  set +e
  (
    cd "$SNAPSHOT_CLAUDE"
    unset PROJECT_ROOT REVIEW_PROMPT_FILE REVIEW_PROMPT_SHA256 REVIEW_PROMPT_B64 PBS_O_WORKDIR
    timeout --signal=TERM --kill-after=30s "${REVIEW_TIMEOUT_SECONDS}s" \
      "$CLAUDE_BIN" -p \
      --model "$CLAUDE_MODEL" \
      --session-id "$session_id" \
      --permission-mode plan \
      --output-format json \
      "$prompt"
  ) >"$raw_file" 2>"$stderr_file"
  exit_code=$?
  set -e

  if [[ "$exit_code" -eq 0 ]]; then
    set +e
    python3 - "$raw_file" "$parsed_report" <<'PY'
import json
import pathlib
import sys

raw_path = pathlib.Path(sys.argv[1])
report_path = pathlib.Path(sys.argv[2])
data = json.loads(raw_path.read_text(encoding="utf-8"))
result = data.get("result")
if not isinstance(result, str) or not result.strip():
    raise SystemExit("Claude JSON does not contain a non-empty result")
report_path.write_text(result.rstrip() + "\n", encoding="utf-8")
PY
    parse_exit=$?
    set -e
    if [[ "$parse_exit" -eq 0 ]] && validate_report "$parsed_report"; then
      mv -- "$parsed_report" "$report_file"
      status="completed"
    else
      status="invalid-output"
      exit_code=65
    fi
  else
    status="$(classify_failure "$exit_code" "$stderr_file" "$raw_file")"
  fi

  snapshot_after="$(snapshot_digest "$SNAPSHOT_CLAUDE")"
  if [[ "$snapshot_after" != "$snapshot_before" ]]; then
    printf 'Reviewer mutated the read-only target snapshot.\n' >>"$stderr_file"
    status="invalid-snapshot-mutation"
    exit_code=66
  fi

  ended_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  write_result_tsv "$result_file" "$reviewer" "$CLAUDE_BIN" "$CLAUDE_MODEL" "$session_id" \
    "$reviewer_prompt_sha256" \
    "$snapshot_before" "$snapshot_after" \
    "$status" "$exit_code" \
    "$started_at" "$ended_at" "$report_file" "$raw_file" "$stderr_file"
  return 0
}

run_opencode() {
  local reviewer="$1"
  local model="$2"
  local lane="$3"
  local snapshot_dir="$4"
  local snapshot_before="$5"
  local report_file="$REPORT_DIR/${reviewer}_${TARGET_COMMIT}_${JOB_STEM}.md"
  local raw_file="$REPORT_DIR/${reviewer}_${TARGET_COMMIT}_${JOB_STEM}_raw.txt"
  local stderr_file="$REPORT_DIR/${reviewer}_${TARGET_COMMIT}_${JOB_STEM}.stderr.log"
  local result_file="$RUN_TMP/${reviewer}.tsv"
  local parsed_report="$RUN_TMP/${reviewer}.md"
  local prompt
  local started_at
  local ended_at
  local exit_code=0
  local status
  local invocation_id
  local reviewer_prompt_sha256
  local snapshot_after="$snapshot_before"

  started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  invocation_id="$(new_uuid)"
  prompt="$(cat "$PROMPT_FILE")$(reviewer_suffix "$reviewer" "$model" "$lane")"
  reviewer_prompt_sha256="$(printf '%s' "$prompt" | sha256sum | awk '{print $1}')"
  if ! command -v "$OPENCODE_BIN" >/dev/null 2>&1; then
    ended_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    : >"$raw_file"
    printf 'OpenCode CLI not found: %s\n' "$OPENCODE_BIN" >"$stderr_file"
    write_result_tsv "$result_file" "$reviewer" "$OPENCODE_BIN" "$model" "$invocation_id" \
      "$reviewer_prompt_sha256" \
      "$snapshot_before" "$snapshot_after" \
      "skipped-tool-unavailable" 127 \
      "$started_at" "$ended_at" "$report_file" "$raw_file" "$stderr_file"
    return 0
  fi

  set +e
  (
    cd "$snapshot_dir"
    unset PROJECT_ROOT REVIEW_PROMPT_FILE REVIEW_PROMPT_SHA256 REVIEW_PROMPT_B64 PBS_O_WORKDIR
    timeout --signal=TERM --kill-after=30s "${REVIEW_TIMEOUT_SECONDS}s" \
      "$OPENCODE_BIN" run --agent plan --model "$model" "$prompt"
  ) >"$raw_file" 2>"$stderr_file"
  exit_code=$?
  set -e

  if [[ "$exit_code" -eq 0 && -s "$raw_file" ]]; then
    cp "$raw_file" "$parsed_report"
    if validate_report "$parsed_report"; then
      mv -- "$parsed_report" "$report_file"
      status="completed"
    else
      status="invalid-output"
      exit_code=65
    fi
  elif [[ "$exit_code" -eq 0 ]]; then
    status="invalid-output"
    exit_code=65
  else
    status="$(classify_failure "$exit_code" "$stderr_file" "$raw_file")"
  fi

  snapshot_after="$(snapshot_digest "$snapshot_dir")"
  if [[ "$snapshot_after" != "$snapshot_before" ]]; then
    printf 'Reviewer mutated the read-only target snapshot.\n' >>"$stderr_file"
    status="invalid-snapshot-mutation"
    exit_code=66
  fi

  ended_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  write_result_tsv "$result_file" "$reviewer" "$OPENCODE_BIN" "$model" "$invocation_id" \
    "$reviewer_prompt_sha256" \
    "$snapshot_before" "$snapshot_after" \
    "$status" "$exit_code" \
    "$started_at" "$ended_at" "$report_file" "$raw_file" "$stderr_file"
  return 0
}

echo "[INFO] PBS_JOBID=$PBS_JOBID"
echo "[INFO] HOSTNAME=$HOST_NAME"
echo "[INFO] PROJECT_ROOT=$PROJECT_ROOT"
echo "[INFO] REVIEW_KIND=$REVIEW_KIND"
echo "[INFO] BASE_COMMIT=$BASE_COMMIT"
echo "[INFO] TARGET_COMMIT=$TARGET_COMMIT"
echo "[INFO] REPORT_DIR=$REPORT_DIR"
echo "[INFO] PROMPT_SHA256=$PROMPT_SHA256"
module list 2>&1 | cat || true

run_claude &
pid_claude=$!
run_opencode \
  "glm-5.2" \
  "$OPENCODE_GLM_MODEL" \
  "requirement-to-assertion traceability, test oracle correctness, coverage, and test maintainability" \
  "$SNAPSHOT_GLM" \
  "$SNAPSHOT_GLM_SHA256" &
pid_glm=$!
run_opencode \
  "deepseek-v4-flash" \
  "$OPENCODE_DEEPSEEK_MODEL" \
  "error paths, races, crash/restart behavior, edge cases, and adversarial counterexamples" \
  "$SNAPSHOT_DEEPSEEK" \
  "$SNAPSHOT_DEEPSEEK_SHA256" &
pid_deepseek=$!
run_opencode \
  "kimi-3" \
  "$OPENCODE_KIMI_MODEL" \
  "cross-module integration, experiment validity, artifact/Checker evidence, and documentation drift" \
  "$SNAPSHOT_KIMI" \
  "$SNAPSHOT_KIMI_SHA256" &
pid_kimi=$!

wait "$pid_claude" || true
wait "$pid_glm" || true
wait "$pid_deepseek" || true
wait "$pid_kimi" || true

SUMMARY_FILE="$REPORT_DIR/reviewer-job_${TARGET_COMMIT}_${JOB_STEM}.json"
SUMMARY_TMP="$RUN_TMP/reviewer-job.json"
[[ ! -e "$SUMMARY_FILE" ]] || die "reviewer summary already exists: $SUMMARY_FILE"
python3 - \
  "$SUMMARY_TMP" \
  "$PLAN_ID" \
  "$REVIEW_ID" \
  "$REVIEW_KIND" \
  "$BASE_COMMIT" \
  "$TARGET_COMMIT" \
  "$PBS_JOBID" \
  "$HOST_NAME" \
  "$PROMPT_SHA256" \
  "$TARGET_TREE" \
  "$DIFF_SHA256" \
  "$RUN_TMP/claude-opus-5.tsv" \
  "$RUN_TMP/glm-5.2.tsv" \
  "$RUN_TMP/deepseek-v4-flash.tsv" \
  "$RUN_TMP/kimi-3.tsv" <<'PY'
import json
import pathlib
import sys

(
    summary_path,
    plan_id,
    review_id,
    review_kind,
    base_commit,
    target_commit,
    pbs_job_id,
    hostname,
    prompt_sha256,
    target_tree,
    diff_sha256,
    *result_paths,
) = sys.argv[1:]

reviewers = []
for result_path in result_paths:
    path = pathlib.Path(result_path)
    if not path.is_file():
        reviewers.append(
            {
                "reviewer": path.stem,
                "status": "failed-command",
                "exit_code": None,
                "error": "reviewer result metadata is missing",
            }
        )
        continue
    fields = path.read_text(encoding="utf-8").rstrip("\n").split("\t")
    if len(fields) != 14:
        reviewers.append(
            {
                "reviewer": path.stem,
                "status": "invalid-output",
                "exit_code": None,
                "error": "reviewer result metadata is malformed",
            }
        )
        continue
    (
        reviewer,
        cli,
        requested_model,
        invocation_id,
        reviewer_prompt_sha256,
        snapshot_before,
        snapshot_after,
        status,
        exit_code,
        started_at,
        ended_at,
        report_file,
        raw_file,
        stderr_file,
    ) = fields
    reviewers.append(
        {
            "reviewer": reviewer,
            "cli": cli,
            "requested_model": requested_model,
            "actual_model": None,
            "invocation_id": invocation_id,
            "prompt_sha256": reviewer_prompt_sha256,
            "snapshot_sha256_before": snapshot_before,
            "snapshot_sha256_after": snapshot_after,
            "identity_verification": "pending-coordinator-validation",
            "status": status,
            "exit_code": int(exit_code),
            "started_at": started_at,
            "ended_at": ended_at,
            "report_file": report_file,
            "raw_file": raw_file,
            "stderr_file": stderr_file,
        }
    )

summary = {
    "schema_version": 2,
    "plan_id": plan_id,
    "review_id": review_id,
    "review_kind": review_kind,
    "base_commit": base_commit,
    "target_commit": target_commit,
    "pbs_job_id": pbs_job_id,
    "compute_hostname": hostname,
    "target_tree": target_tree,
    "target_diff_sha256": diff_sha256,
    "prompt_sha256": prompt_sha256,
    "external_review_is_best_effort": True,
    "reviewers": reviewers,
}
pathlib.Path(summary_path).write_text(
    json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8"
)
PY
mv -- "$SUMMARY_TMP" "$SUMMARY_FILE"

echo "[INFO] external reviewer job reached terminal orchestration state"
echo "[INFO] summary=$SUMMARY_FILE"
echo "[INFO] target_tree=$TARGET_TREE"
echo "[INFO] target_diff_sha256=$DIFF_SHA256"
exit 0
