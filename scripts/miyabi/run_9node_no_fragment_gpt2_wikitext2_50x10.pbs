#!/bin/bash
#PBS -N fsdiloco_full_50x10
#PBS -q regular-g
#PBS -W group_list=xg24i002
#PBS -l select=9:mpiprocs=1
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
trap 'echo "[ERROR] Failed at line $LINENO" >&2' ERR

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PRIMARY_WORKTREE_ROOT="${PRIMARY_WORKTREE_ROOT:-/work/xg24i002/x10041/fsb_decoupled_diloco}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
CONFIG="${CONFIG:-$PROJECT_ROOT/configs/fs_diloco_gpt2_wikitext2_8l_no_fragment_50x10.yaml}"
RUN_ID="${RUN_ID:-$(date +%Y%m%d_%H%M%S)_fs_diloco_gpt2_wikitext2_8l_no_fragment_50x10}"
SHARED_ROOT="${SHARED_ROOT:-$PRIMARY_WORKTREE_ROOT/runs/fs_diloco/$RUN_ID}"
LOCAL_RUNTIME_DIR="${LOCAL_RUNTIME_DIR:-${TMPDIR:-/tmp}/fs_diloco/$RUN_ID}"
CACHE_ROOT="${CACHE_ROOT:-$PROJECT_ROOT/.cache/fs_diloco}"
HF_HOME="${HF_HOME:-$CACHE_ROOT/huggingface}"
HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$HF_HOME/datasets}"
HF_HUB_CACHE="${HF_HUB_CACHE:-$HF_HOME/hub}"
HF_DATASETS_OFFLINE="${HF_DATASETS_OFFLINE:-0}"
HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-0}"
FS_DILOCO_HF_WIKITEXT_REPO="${FS_DILOCO_HF_WIKITEXT_REPO:-Salesforce/wikitext}"
WANDB_MODE="${WANDB_MODE:-online}"
WANDB_DIR="${WANDB_DIR:-$SHARED_ROOT/wandb}"
WANDB_CACHE_DIR="${WANDB_CACHE_DIR:-$LOCAL_RUNTIME_DIR/wandb/cache}"
WANDB_CONFIG_DIR="${WANDB_CONFIG_DIR:-$LOCAL_RUNTIME_DIR/wandb/config}"
WANDB_DATA_DIR="${WANDB_DATA_DIR:-$LOCAL_RUNTIME_DIR/wandb/data}"
SYNCER_CUDA_VISIBLE_DEVICES="${SYNCER_CUDA_VISIBLE_DEVICES:-0}"
LEARNER_CUDA_VISIBLE_DEVICES="${LEARNER_CUDA_VISIBLE_DEVICES:-0}"
NUM_LEARNERS=8
TRAINING_SEED="${TRAINING_SEED:-}"
PARALLEL_CHECKPOINT_WRITES="${PARALLEL_CHECKPOINT_WRITES:-}"
OMP_NUM_THREADS="${OMP_NUM_THREADS:-8}"
TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-false}"

: "${PBS_NODEFILE:?PBS_NODEFILE is not set}"
cd "$PROJECT_ROOT"

if [[ ! -x "$PYTHON_BIN" ]]; then
  echo "Python executable not found or not executable: $PYTHON_BIN" >&2
  exit 2
fi

mapfile -t HOSTS < <(sort -u "$PBS_NODEFILE")
NNODES="${#HOSTS[@]}"
if [[ "$NNODES" -ne 9 ]]; then
  echo "Expected 9 unique nodes, got $NNODES" >&2
  printf '%s\n' "${HOSTS[@]}" >&2
  exit 2
fi

mkdir -p \
  "$SHARED_ROOT" \
  "$PRIMARY_WORKTREE_ROOT/logs" \
  "$HF_DATASETS_CACHE" \
  "$HF_HUB_CACHE" \
  "$WANDB_DIR" \
  "$WANDB_CACHE_DIR" \
  "$WANDB_CONFIG_DIR" \
  "$WANDB_DATA_DIR"
LOG_ROOT="$PRIMARY_WORKTREE_ROOT/logs/qsub_${RUN_ID}"
mkdir -p "$LOG_ROOT"
SOURCE_IDENTITY_JSON="$SHARED_ROOT/control/source_identity.json"
SOURCE_IDENTITY_ENV="$SHARED_ROOT/control/source_identity.env"
"$PYTHON_BIN" "$PROJECT_ROOT/scripts/miyabi/capture_source_identity.py" \
  --project-root "$PROJECT_ROOT" \
  --output-json "$SOURCE_IDENTITY_JSON" \
  --output-env "$SOURCE_IDENTITY_ENV" | tee "$LOG_ROOT/source_identity.log"
source "$SOURCE_IDENTITY_ENV"

MPI_ENV_ARGS=(
  "FS_DILOCO_GIT_COMMIT=$FS_DILOCO_GIT_COMMIT"
  "FS_DILOCO_GIT_DIRTY=$FS_DILOCO_GIT_DIRTY"
  "FS_DILOCO_SOURCE_FINGERPRINT=$FS_DILOCO_SOURCE_FINGERPRINT"
  "FS_DILOCO_REQUIRE_SOURCE_IDENTITY=$FS_DILOCO_REQUIRE_SOURCE_IDENTITY"
  "PROJECT_ROOT=$PROJECT_ROOT"
  "PRIMARY_WORKTREE_ROOT=$PRIMARY_WORKTREE_ROOT"
  "PYTHON_BIN=$PYTHON_BIN"
  "CONFIG=$CONFIG"
  "RUN_ID=$RUN_ID"
  "SHARED_ROOT=$SHARED_ROOT"
  "LOCAL_RUNTIME_DIR=$LOCAL_RUNTIME_DIR"
  "CACHE_ROOT=$CACHE_ROOT"
  "HF_HOME=$HF_HOME"
  "HF_DATASETS_CACHE=$HF_DATASETS_CACHE"
  "HF_HUB_CACHE=$HF_HUB_CACHE"
  "HF_DATASETS_OFFLINE=$HF_DATASETS_OFFLINE"
  "HF_HUB_OFFLINE=$HF_HUB_OFFLINE"
  "FS_DILOCO_HF_WIKITEXT_REPO=$FS_DILOCO_HF_WIKITEXT_REPO"
  "WANDB_MODE=$WANDB_MODE"
  "WANDB_DIR=$WANDB_DIR"
  "WANDB_CACHE_DIR=$WANDB_CACHE_DIR"
  "WANDB_CONFIG_DIR=$WANDB_CONFIG_DIR"
  "WANDB_DATA_DIR=$WANDB_DATA_DIR"
  "SYNCER_CUDA_VISIBLE_DEVICES=$SYNCER_CUDA_VISIBLE_DEVICES"
  "LEARNER_CUDA_VISIBLE_DEVICES=$LEARNER_CUDA_VISIBLE_DEVICES"
  "NUM_LEARNERS=$NUM_LEARNERS"
  "TRAINING_SEED=$TRAINING_SEED"
  "PARALLEL_CHECKPOINT_WRITES=$PARALLEL_CHECKPOINT_WRITES"
  "OMP_NUM_THREADS=$OMP_NUM_THREADS"
  "TOKENIZERS_PARALLELISM=$TOKENIZERS_PARALLELISM"
)

echo "RUN_ID=$RUN_ID"
echo "SOURCE_FINGERPRINT=$FS_DILOCO_SOURCE_FINGERPRINT"
echo "PROJECT_ROOT=$PROJECT_ROOT"
echo "PYTHON_BIN=$PYTHON_BIN"
echo "CONFIG=$CONFIG"
echo "SHARED_ROOT=$SHARED_ROOT"
echo "SQLITE_DB=$SHARED_ROOT/control/syncer_metadata.sqlite3"
echo "WANDB_MODE=$WANDB_MODE"
echo "TRAINING_SEED=${TRAINING_SEED:-<config>}"
echo "PARALLEL_CHECKPOINT_WRITES=${PARALLEL_CHECKPOINT_WRITES:-<config>}"
echo "NNODES=$NNODES NUM_LEARNERS=$NUM_LEARNERS"
printf 'HOST %s\n' "${HOSTS[@]}"

mpirun \
  --mca mpi_abort_print_stack 1 \
  --report-bindings \
  --bind-to none \
  -np "$NNODES" \
  /usr/bin/env "${MPI_ENV_ARGS[@]}" \
  bash -lc '
    set -eEuo pipefail
    rank="${OMPI_COMM_WORLD_RANK:?missing OMPI_COMM_WORLD_RANK}"
    host="$(hostname)"
    config_args=()
    if [[ -n "$TRAINING_SEED" ]]; then
      config_args+=(--training-seed "$TRAINING_SEED")
    fi
    case "${PARALLEL_CHECKPOINT_WRITES,,}" in
      "") ;;
      1|true|yes|on) config_args+=(--parallel-checkpoint-writes) ;;
      0|false|no|off) config_args+=(--no-parallel-checkpoint-writes) ;;
      *) echo "Invalid PARALLEL_CHECKPOINT_WRITES=$PARALLEL_CHECKPOINT_WRITES" >&2; exit 2 ;;
    esac
    echo "[launcher] rank=${rank} host=${host}"
    if [[ "$rank" -eq 0 ]]; then
      export CUDA_VISIBLE_DEVICES="$SYNCER_CUDA_VISIBLE_DEVICES"
      exec "$PYTHON_BIN" -m fs_diloco.syncer \
        --config "$CONFIG" \
        --run-id "$RUN_ID" \
        --shared-root "$SHARED_ROOT" \
        --num-learners "$NUM_LEARNERS" \
        "${config_args[@]}" \
        2>&1 | tee "$PRIMARY_WORKTREE_ROOT/logs/qsub_${RUN_ID}/syncer.log"
    else
      learner_num=$((rank - 1))
      learner_id=$(printf "learner_%03d" "$learner_num")
      export CUDA_VISIBLE_DEVICES="$LEARNER_CUDA_VISIBLE_DEVICES"
      exec "$PYTHON_BIN" -m fs_diloco.learner \
        --config "$CONFIG" \
        --run-id "$RUN_ID" \
        --shared-root "$SHARED_ROOT" \
        --learner-id "$learner_id" \
        --num-learners "$NUM_LEARNERS" \
        "${config_args[@]}" \
        2>&1 | tee "$PRIMARY_WORKTREE_ROOT/logs/qsub_${RUN_ID}/${learner_id}.log"
    fi
  '

"$PYTHON_BIN" -m fs_diloco.analysis summary "$SHARED_ROOT" --json \
  | tee "$LOG_ROOT/summary.json" "$SHARED_ROOT/analysis_summary.json"
