#!/bin/bash
#PBS -N fsdiloco_p2_chaos_check
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:00:20
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] Phase 2 chaos evidence checker failed at line $LINENO" >&2' ERR

: "${PHASE2_ACCEPTANCE_KIND:?PHASE2_ACCEPTANCE_KIND is required}"
: "${FS_DILOCO_SHARED_ROOT:?FS_DILOCO_SHARED_ROOT is required}"
: "${PHASE2_RECEIPTS:?PHASE2_RECEIPTS is required}"
: "${PHASE2_EVIDENCE_OUTPUT:?PHASE2_EVIDENCE_OUTPUT is required}"
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
cd "$PROJECT_ROOT"

"$PYTHON_BIN" -m fs_diloco.tools.phase2_chaos_evidence \
  --kind "$PHASE2_ACCEPTANCE_KIND" \
  --run-root "$FS_DILOCO_SHARED_ROOT" \
  --receipts "$PHASE2_RECEIPTS" \
  --output "$PHASE2_EVIDENCE_OUTPUT"
