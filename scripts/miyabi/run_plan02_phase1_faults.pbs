#!/bin/bash
#PBS -N fsdiloco_p1_faults
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:03:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] Phase 1 fault matrix failed at line $LINENO" >&2' ERR

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
STAMP="${STAMP:-$(date +%Y%m%d-%H%M%S)}"
JOB_ID_SHORT="${PBS_JOBID%%.*}"
REPORT_ROOT="$PROJECT_ROOT/reports/DOING/fsb_decoupled_diloco_plan_02"
WORK_DIR="${TMPDIR:?TMPDIR is required}/plan02_phase1_faults_${JOB_ID_SHORT}"
OUTPUT="$REPORT_ROOT/artifacts/${STAMP}_phase1-fault-matrix_pass.json"
IDENTITY_ROOT="$WORK_DIR/source_identity"

cd "$PROJECT_ROOT"
mkdir -p "$WORK_DIR" "$REPORT_ROOT/artifacts"
"$PYTHON_BIN" scripts/miyabi/capture_source_identity.py \
  --project-root "$PROJECT_ROOT" \
  --output-json "$IDENTITY_ROOT.json" \
  --output-env "$IDENTITY_ROOT.env"
source "$IDENTITY_ROOT.env"

"$PYTHON_BIN" scripts/miyabi/plan02_phase1_fault_probe.py \
  --root "$WORK_DIR/runs" \
  --iterations 10 \
  --output "$OUTPUT"

test -s "$OUTPUT"
printf 'PLAN02_PHASE1_FAULT_ARTIFACT=%s\n' "$OUTPUT"
