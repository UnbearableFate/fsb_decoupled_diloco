#!/bin/bash
#PBS -N fsdiloco_p6_g10
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:30:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] P6 G10 failed at line $LINENO" >&2' ERR
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
export CUDA_VISIBLE_DEVICES=""
export PYTHONDONTWRITEBYTECODE=1
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
UV_BIN="${UV_BIN:-$(command -v uv)}"
: "${CLASSIC_EVIDENCE_OUTPUT:?CLASSIC_EVIDENCE_OUTPUT is required}"
: "${DYNAMIC_EVIDENCE_OUTPUT:?DYNAMIC_EVIDENCE_OUTPUT is required}"
: "${TMPDIR:?TMPDIR is required}"
CLASSIC_ROOT="$TMPDIR/plan03-classic-worktree"
CURRENT_VENV="$TMPDIR/plan03-current-venv"
CLASSIC_VENV="$TMPDIR/plan03-classic-venv"
REQUIREMENTS="$TMPDIR/plan03-g10-requirements.txt"
SHARED_PARENT="${SHARED_PARENT:-$PROJECT_ROOT/runs/fs_diloco}"

cleanup() {
  if [[ -d "$CLASSIC_ROOT" ]]; then
    git -C "$PROJECT_ROOT" worktree remove --force "$CLASSIC_ROOT" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT INT TERM

cd "$PROJECT_ROOT"
git worktree add --detach "$CLASSIC_ROOT" archive/classic-full-v1-final
UV_PROJECT_ENVIRONMENT="$CURRENT_VENV" "$UV_BIN" sync \
  --project "$PROJECT_ROOT" --frozen --no-dev
"$UV_BIN" export --project "$PROJECT_ROOT" --frozen --no-dev \
  --no-emit-project --output-file "$REQUIREMENTS"
"$UV_BIN" venv "$CLASSIC_VENV"
"$UV_BIN" pip sync --python "$CLASSIC_VENV/bin/python" "$REQUIREMENTS"
"$UV_BIN" pip install --python "$CLASSIC_VENV/bin/python" --no-deps -e "$CLASSIC_ROOT"
test "$CURRENT_VENV/bin/python" != "$CLASSIC_VENV/bin/python"

"$CURRENT_VENV/bin/python" scripts/miyabi/plan03_p6_performance.py \
  --comparison classic \
  --current-root "$PROJECT_ROOT" \
  --current-python "$CURRENT_VENV/bin/python" \
  --classic-root "$CLASSIC_ROOT" \
  --classic-python "$CLASSIC_VENV/bin/python" \
  --shared-parent "$SHARED_PARENT" \
  --output "$CLASSIC_EVIDENCE_OUTPUT"

"$CURRENT_VENV/bin/python" scripts/miyabi/plan03_p6_performance.py \
  --comparison dynamic \
  --current-root "$PROJECT_ROOT" \
  --current-python "$CURRENT_VENV/bin/python" \
  --shared-parent "$SHARED_PARENT" \
  --output "$DYNAMIC_EVIDENCE_OUTPUT"
