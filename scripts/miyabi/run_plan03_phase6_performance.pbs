#!/bin/bash
#PBS -N fsdiloco_p6_g10
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:30:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] P6 G10 failed at line $LINENO" >&2' ERR
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
export CUDA_VISIBLE_DEVICES=""
export PYTHONDONTWRITEBYTECODE=1
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
UV_BIN="${UV_BIN:-$(command -v uv)}"
: "${CLASSIC_EVIDENCE_OUTPUT:?CLASSIC_EVIDENCE_OUTPUT is required}"
: "${DYNAMIC_EVIDENCE_OUTPUT:?DYNAMIC_EVIDENCE_OUTPUT is required}"
: "${TMPDIR:?TMPDIR is required}"
CLASSIC_ROOT="$TMPDIR/plan03-classic-worktree"
CURRENT_VENV="$TMPDIR/plan03-current-venv"
CLASSIC_VENV="$TMPDIR/plan03-classic-venv"
SHARED_PARENT="${SHARED_PARENT:-$PROJECT_ROOT/runs/fs_diloco}"
CLASSIC_REF="archive/classic-full-v1-final"

cleanup() {
  if [[ -d "$CLASSIC_ROOT" ]]; then
    git -C "$PROJECT_ROOT" worktree remove --force "$CLASSIC_ROOT" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT INT TERM

cd "$PROJECT_ROOT"
CLASSIC_COMMIT="$(git rev-parse "${CLASSIC_REF}^{commit}")"
git worktree add --detach "$CLASSIC_ROOT" "$CLASSIC_COMMIT"
test "$(git -C "$CLASSIC_ROOT" rev-parse HEAD)" = "$CLASSIC_COMMIT"
UV_PROJECT_ENVIRONMENT="$CURRENT_VENV" "$UV_BIN" sync \
  --project "$PROJECT_ROOT" --frozen --no-dev
UV_PROJECT_ENVIRONMENT="$CLASSIC_VENV" "$UV_BIN" sync \
  --project "$PROJECT_ROOT" --frozen --no-dev
"$UV_BIN" pip install --python "$CLASSIC_VENV/bin/python" \
  --no-deps --reinstall -e "$CLASSIC_ROOT"
test "$CURRENT_VENV/bin/python" != "$CLASSIC_VENV/bin/python"
CURRENT_PACKAGE="$(cd "$TMPDIR" && "$CURRENT_VENV/bin/python" -c 'from pathlib import Path; import fs_diloco; print(Path(fs_diloco.__file__).resolve())')"
CLASSIC_PACKAGE="$(cd "$TMPDIR" && "$CLASSIC_VENV/bin/python" -c 'from pathlib import Path; import fs_diloco; print(Path(fs_diloco.__file__).resolve())')"
test "$CURRENT_PACKAGE" = "$PROJECT_ROOT/fs_diloco/__init__.py"
test "$CLASSIC_PACKAGE" = "$CLASSIC_ROOT/fs_diloco/__init__.py"
CURRENT_TORCH="$(cd "$TMPDIR" && "$CURRENT_VENV/bin/python" -c 'import torch; print(torch.__version__)')"
CLASSIC_TORCH="$(cd "$TMPDIR" && "$CLASSIC_VENV/bin/python" -c 'import torch; print(torch.__version__)')"
test "$CURRENT_TORCH" = "$CLASSIC_TORCH"

"$CURRENT_VENV/bin/python" scripts/miyabi/plan03_p6_performance.py \
  --comparison classic \
  --current-root "$PROJECT_ROOT" \
  --current-python "$CURRENT_VENV/bin/python" \
  --classic-root "$CLASSIC_ROOT" \
  --classic-python "$CLASSIC_VENV/bin/python" \
  --shared-parent "$SHARED_PARENT" \
  --output "$CLASSIC_EVIDENCE_OUTPUT"

"$CURRENT_VENV/bin/python" scripts/miyabi/plan03_p6_performance.py \
  --comparison dynamic \
  --current-root "$PROJECT_ROOT" \
  --current-python "$CURRENT_VENV/bin/python" \
  --shared-parent "$SHARED_PARENT" \
  --output "$DYNAMIC_EVIDENCE_OUTPUT"
