#!/bin/bash
#PBS -N fsdiloco_plan03_perf
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] Failed at line $LINENO" >&2' ERR

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
export PYTHONDONTWRITEBYTECODE=1
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
cd "$PROJECT_ROOT"

OUTPUT="reports/DOING/fsb_decoupled_diloco_plan_03_unified_ha/artifacts/$(date +%Y%m%d-%H%M%S)_p0-paired-tiny-feasibility_pass.json"
"$PYTHON_BIN" scripts/miyabi/plan03_p0_performance.py \
  --project-root "$PROJECT_ROOT" \
  --shared-parent "$PROJECT_ROOT/runs" \
  --output "$OUTPUT"

printf 'PLAN03_P0_PERFORMANCE_ARTIFACT=%s\n' "$OUTPUT"
printf 'PLAN03_P0_PERFORMANCE_COMPLETE=%s\n' "${PBS_JOBID:-unknown}"
