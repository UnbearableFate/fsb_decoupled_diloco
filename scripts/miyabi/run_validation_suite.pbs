#!/bin/bash
#PBS -N fsdiloco_validation
#PBS -q regular-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] validation suite failed at line $LINENO" >&2' ERR

: "${VALIDATION_RAW_LOG:?VALIDATION_RAW_LOG is required}"
: "${VALIDATION_OUTPUT:?VALIDATION_OUTPUT is required}"
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"

cd "$PROJECT_ROOT"
test -x "$PYTHON_BIN"
exec "$PYTHON_BIN" "$PROJECT_ROOT/scripts/miyabi/run_validation_suite.py" \
  --project-root "$PROJECT_ROOT" \
  --raw-log "$VALIDATION_RAW_LOG" \
  --output "$VALIDATION_OUTPUT"
