#!/bin/bash
#PBS -N fsdiloco_p4_error_successor
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] Failed at line $LINENO" >&2' ERR
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
export CUDA_VISIBLE_DEVICES=""
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
RUNS_ROOT="${RUNS_ROOT:-$PROJECT_ROOT/runs/fs_diloco}"
RUN_ID="${RUN_ID:-plan03_p4_error_successor_${PBS_JOBID%%.*}}"
RUN_ROOT="$RUNS_ROOT/$RUN_ID"
LOG_ROOT="${LOG_ROOT:-$PROJECT_ROOT/logs/qsub_${RUN_ID}}"
TMP_ROOT="${TMPDIR:?TMPDIR is required}"
TEST_CONFIG="$TMP_ROOT/${RUN_ID}.yaml"
mkdir -p "$LOG_ROOT"
cd "$PROJECT_ROOT"

readarray -t source_identity < <(
  "$PYTHON_BIN" - "$PROJECT_ROOT" <<'PY'
import sys
from pathlib import Path

sys.path.insert(0, str(Path(sys.argv[1]) / "scripts/miyabi"))
from capture_source_identity import capture

value = capture(Path(sys.argv[1]))
print(value["git_commit"])
print(int(value["git_dirty"]))
print(value["source_fingerprint"])
PY
)
export FS_DILOCO_GIT_COMMIT="${source_identity[0]}"
export FS_DILOCO_GIT_DIRTY="${source_identity[1]}"
export FS_DILOCO_SOURCE_FINGERPRINT="${source_identity[2]}"
export FS_DILOCO_REQUIRE_SOURCE_IDENTITY=1

"$PYTHON_BIN" - configs/fs_diloco_tiny_ha_static.yaml "$TEST_CONFIG" <<'PY'
from pathlib import Path
import sys
import yaml

source, target = map(Path, sys.argv[1:])
config = yaml.safe_load(source.read_text(encoding="utf-8"))
config["sync"].update(
    num_learners=1,
    quorum_min=1,
    quorum_max=1,
    stop_after_outer_steps=20,
)
config["training"]["completion_mode"] = "global_only"
assert config["coordination"]["recovery_submission"]["enabled"] is False
target.write_text(yaml.safe_dump(config, sort_keys=False), encoding="utf-8")
PY

"$PYTHON_BIN" -m fs_diloco.tools.init_run \
  --config "$TEST_CONFIG" \
  --run-id "$RUN_ID" \
  --shared-root "$RUN_ROOT" \
  --project-root "$PROJECT_ROOT" \
  --allow-dirty-snapshot \
  > "$LOG_ROOT/init_run.json"
readarray -t descriptor_fields < <(
  "$PYTHON_BIN" - "$LOG_ROOT/init_run.json" <<'PY'
import json
import sys

descriptor = json.load(open(sys.argv[1], encoding="utf-8"))["descriptor"]
print(descriptor["resolved_config_path"])
print(descriptor["descriptor_sha256"])
PY
)
CONFIG="${descriptor_fields[0]}"
export FS_DILOCO_EXPECTED_DESCRIPTOR_SHA256="${descriptor_fields[1]}"
export FS_DILOCO_EXPECTED_GIT_COMMIT="$FS_DILOCO_GIT_COMMIT"
export FS_DILOCO_EXPECTED_SOURCE_FINGERPRINT="$FS_DILOCO_SOURCE_FINGERPRINT"

first_pid=""
second_pid=""
learner_pid=""
cleanup() {
  kill "$first_pid" "$second_pid" "$learner_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

"$PYTHON_BIN" -m fs_diloco.learner \
  --config "$CONFIG" --shared-root "$RUN_ROOT" \
  --learner-id learner_000 \
  --logical-launch-id "manual-successor-${PBS_JOBID%%.*}" \
  > "$LOG_ROOT/learner.log" 2>&1 &
learner_pid=$!
FS_DILOCO_TEST_FAIL_AFTER_COMMITTED_VERSION=2 \
  "$PYTHON_BIN" -m fs_diloco.syncer \
    --config "$CONFIG" --shared-root "$RUN_ROOT" \
    > "$LOG_ROOT/syncer_failed.log" 2>&1 &
first_pid=$!

first_status=0
wait "$first_pid" || first_status=$?
first_pid=""
if [[ "$first_status" -eq 0 ]]; then
  echo "Injected candidate unexpectedly exited zero" >&2
  exit 1
fi
if ! rg -q 'injected candidate failure after committed version 2' \
  "$LOG_ROOT/syncer_failed.log"; then
  tail -n 180 "$LOG_ROOT/syncer_failed.log" >&2 || true
  echo "Candidate did not fail at the requested committed-version boundary" >&2
  exit 1
fi
printf 'FAILED_CANDIDATE_STATUS=%s\n' "$first_status"

"$PYTHON_BIN" - "$RUN_ROOT" <<'PY'
import json
from pathlib import Path
import sqlite3
import sys

from fs_diloco.storage.atomic_io import atomic_write_json

root = Path(sys.argv[1])
connection = sqlite3.connect(root / "control/syncer_metadata.sqlite3")
connection.row_factory = sqlite3.Row
try:
    versions = [row[0] for row in connection.execute("SELECT version FROM global_versions ORDER BY version")]
    assert versions == [0, 1, 2]
    epoch = connection.execute("SELECT * FROM syncer_epochs WHERE epoch=1").fetchone()
    assert epoch is not None and epoch["final_state"] == "error"
    assert connection.execute("SELECT COUNT(*) FROM terminal_state").fetchone()[0] == 0
finally:
    connection.close()
errors = list((root / "control/syncer_epochs").glob("e000001_*/errors/*.json"))
assert len(errors) == 1
payload = json.loads(errors[0].read_text(encoding="utf-8"))
assert payload["kind"] == "candidate_error"
assert payload["error_type"] == "RuntimeError"
atomic_write_json(
    root / "control/latest.json",
    {
        "format_version": 2,
        "kind": "latest",
        "run_id": root.name,
        "epoch": 999,
        "owner_id": "polluted",
        "version": 999,
    },
)
PY

"$PYTHON_BIN" -m fs_diloco.syncer \
  --config "$CONFIG" --shared-root "$RUN_ROOT" \
  > "$LOG_ROOT/syncer_successor.log" 2>&1 &
second_pid=$!
wait "$learner_pid"
learner_pid=""
wait "$second_pid"
second_pid=""
trap - EXIT INT TERM

"$PYTHON_BIN" - "$RUN_ROOT" <<'PY'
import json
from pathlib import Path
import sqlite3
import sys

import yaml

root = Path(sys.argv[1])
resolved = yaml.safe_load(
    (root / "control/run_config.resolved.yaml").read_text(encoding="utf-8")
)
assert resolved["coordination"]["recovery_submission"]["enabled"] is False
connection = sqlite3.connect(root / "control/syncer_metadata.sqlite3")
connection.row_factory = sqlite3.Row
try:
    assert connection.execute("PRAGMA integrity_check").fetchone()[0] == "ok"
    versions = [row[0] for row in connection.execute("SELECT version FROM global_versions ORDER BY version")]
    terminal = connection.execute("SELECT * FROM terminal_state").fetchone()
    assert terminal is not None and terminal["state"] == "finalized"
    assert versions == list(range(terminal["final_version"] + 1))
    epochs = connection.execute(
        "SELECT epoch, final_state, MIN(version) AS min_version, MAX(version) AS max_version "
        "FROM syncer_epochs LEFT JOIN global_versions ON committed_by_epoch=epoch "
        "GROUP BY epoch ORDER BY epoch"
    ).fetchall()
    assert [row["final_state"] for row in epochs] == ["error", "released"]
    assert epochs[0]["max_version"] == 2
    assert epochs[1]["min_version"] == 3
    fences = connection.execute(
        "SELECT state, hard_crash_gap_tokens_upper_bound FROM terminal_contributor_fences"
    ).fetchall()
    assert len(fences) == 1 and fences[0]["state"] == "acked"
    assert fences[0]["hard_crash_gap_tokens_upper_bound"] == 0
finally:
    connection.close()
latest = json.loads((root / "control/latest.json").read_text(encoding="utf-8"))
assert latest["version"] == terminal["final_version"]
assert latest["epoch"] == 2
summary = json.loads((root / "control/summary.json").read_text(encoding="utf-8"))
assert summary["all_learners_stopped"] is True
print(json.dumps({"epochs": [dict(row) for row in epochs], "summary": summary}, sort_keys=True))
PY
printf 'PLAN03_PHASE4_ERROR_SUCCESSOR_COMPLETE=%s\n' "${PBS_JOBID:-unknown}"
