#!/bin/bash
#PBS -N fsdiloco_plan03_p3
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] Failed at line $LINENO" >&2' ERR

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
export PYTHONDONTWRITEBYTECODE=1
export PLAN03_HYPOTHESIS_PROFILE=plan03-phase
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
RUFF_BIN="${RUFF_BIN:-$PROJECT_ROOT/.venv/bin/ruff}"
cd "$PROJECT_ROOT"

hostname
printf 'PBS_JOBID=%s\n' "${PBS_JOBID:-unknown}"
"$PYTHON_BIN" - <<'PY'
import platform
import sys

import hypothesis
import pytest
import torch

print(f"python={sys.version.split()[0]}")
print(f"platform={platform.platform()}")
print(f"hypothesis={hypothesis.__version__}")
print(f"pytest={pytest.__version__}")
print(f"torch={torch.__version__}")
PY

"$RUFF_BIN" check fs_diloco tests scripts/miyabi
"$RUFF_BIN" format --check \
  fs_diloco/core/config.py \
  fs_diloco/core/config_v4.py \
  fs_diloco/core/run_descriptor.py \
  fs_diloco/observability/logging_utils.py \
  fs_diloco/protocol/__init__.py \
  fs_diloco/protocol/authority.py \
  fs_diloco/protocol/data_cursor.py \
  fs_diloco/protocol/merge.py \
  fs_diloco/protocol/scheduler.py \
  fs_diloco/protocol/selection.py \
  fs_diloco/protocol/token_accounting.py \
  fs_diloco/runtime/launch_outbox.py \
  fs_diloco/storage/atomic_io.py \
  fs_diloco/storage/artifact_policy.py \
  fs_diloco/storage/audit_archive.py \
  fs_diloco/storage/authority.py \
  fs_diloco/storage/fenced_store.py \
  fs_diloco/storage/leader_lease.py \
  fs_diloco/storage/paths.py \
  fs_diloco/storage/run_initializer.py \
  fs_diloco/storage/schema_bootstrap.py \
  fs_diloco/tools/check_workload_equivalence.py \
  fs_diloco/tools/clean_run.py \
  fs_diloco/tools/init_run.py \
  fs_diloco/tools/resolve_scheduler_uncertainty.py \
  scripts/miyabi/check_plan03.py \
  tests/observability/test_p3_operational_evidence.py \
  tests/protocol/test_p3_accounting_selection_cursor.py \
  tests/protocol/test_p3_unified_v4_golden.py \
  tests/storage/test_artifact_policy_p3.py \
  tests/storage/test_audit_archive_p3.py \
  tests/storage/test_authority_p3_operational.py \
  tests/storage/test_run_initializer_p3.py \
  tests/storage/test_schema_v4.py \
  tests/tools/test_resolve_scheduler_uncertainty.py \
  tests/test_plan02_phase1_ha.py \
  tests/test_plan02_phase2_dynamic.py \
  tests/test_clean_run.py \
  tests/test_plan03_checker.py \
  tests/test_plan03_p0_red.py

"$PYTHON_BIN" scripts/miyabi/check_plan03.py \
  --root "$PROJECT_ROOT" \
  --expect reports/DOING/fsb_decoupled_diloco_plan_03_unified_ha/artifacts/20260808-223500_p0-runtime-surface-inventory_review.json \
  --verify-boundaries \
  --verify-phase-requirements P3-operational-robustness \
  --inventory-output "${PLAN03_CHECKER_OUTPUT:-$PROJECT_ROOT/reports/DOING/fsb_decoupled_diloco_plan_03_unified_ha/artifacts/${PBS_JOBID//./_}_p3-requirements.json}"

"$PYTHON_BIN" -m pytest -q \
  tests/protocol \
  tests/storage \
  tests/observability \
  tests/tools \
  tests/architecture \
  tests/test_plan03_p0_red.py \
  tests/test_plan02_phase1_ha.py

"$PYTHON_BIN" -m pytest -q

printf 'PLAN03_PHASE3_TESTS_COMPLETE=%s\n' "${PBS_JOBID:-unknown}"
