#!/bin/bash
#PBS -N fsdiloco_plan03_p0
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] Failed at line $LINENO" >&2' ERR

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
export PYTHONDONTWRITEBYTECODE=1
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
cd "$PROJECT_ROOT"

hostname
printf 'PBS_JOBID=%s\n' "${PBS_JOBID:-unknown}"
"$PYTHON_BIN" - <<'PY'
import platform
import sys

import pytest
import torch

print(f"python={sys.version.split()[0]}")
print(f"platform={platform.platform()}")
print(f"pytest={pytest.__version__}")
print(f"torch={torch.__version__}")
PY

CHECKER_OUTPUT="reports/DOING/fsb_decoupled_diloco_plan_03_unified_ha/artifacts/$(date +%Y%m%d-%H%M%S)_p0-current-boundary-check_review.json"
"$PYTHON_BIN" scripts/miyabi/check_plan03.py \
  --root "$PROJECT_ROOT" \
  --expect reports/DOING/fsb_decoupled_diloco_plan_03_unified_ha/artifacts/20260808-223500_p0-runtime-surface-inventory_review.json \
  --verify-boundaries \
  --inventory-output "$CHECKER_OUTPUT"
printf 'PLAN03_CHECKER_ARTIFACT=%s\n' "$CHECKER_OUTPUT"

mkdir -p "$PROJECT_ROOT/runs"
"$PYTHON_BIN" scripts/miyabi/plan03_fs_capability.py \
  --project-root "$PROJECT_ROOT" \
  --shared-parent "$PROJECT_ROOT/runs" \
  --output-dir reports/DOING/fsb_decoupled_diloco_plan_03_unified_ha/artifacts
if find reports/DOING/fsb_decoupled_diloco_plan_03_unified_ha/artifacts \
  -maxdepth 1 -type d -name '.plan03-fs-capability-*' -print -quit | grep -q .; then
  echo "FS capability scratch leaked into the evidence directory" >&2
  exit 1
fi

"$PYTHON_BIN" -m pytest -q \
  tests/test_plan03_support.py \
  tests/test_plan03_checker.py \
  tests/test_plan03_fs_capability.py \
  tests/test_plan03_p0_performance.py \
  tests/reference/test_plan03_classic_static_oracle.py \
  tests/test_plan03_p0_red.py

RED_LOG="reports/DOING/fsb_decoupled_diloco_plan_03_unified_ha/artifacts/$(date +%Y%m%d-%H%M%S)_p0-red-runxfail_review.log"
set +e
"$PYTHON_BIN" -m pytest -q --runxfail tests/test_plan03_p0_red.py >"$RED_LOG" 2>&1
RED_STATUS=$?
set -e
if [[ "$RED_STATUS" -ne 1 ]] || ! grep -Eq '(^|[^0-9])5 failed([^0-9]|$)' "$RED_LOG"; then
  cat "$RED_LOG"
  echo "Unexpected RED evidence status: $RED_STATUS" >&2
  exit 1
fi
cat "$RED_LOG"
printf 'PLAN03_RED_LOG=%s\n' "$RED_LOG"

"$PYTHON_BIN" -m pytest -q

printf 'PLAN03_PHASE0_TESTS_COMPLETE=%s\n' "${PBS_JOBID:-unknown}"
