#!/bin/bash
#PBS -N fsdiloco_plan03_p0
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -o reports/DOING/fsb_decoupled_diloco_plan_03_unified_ha/artifacts/20260809-001500_p0-final-compute.log

set -eEuo pipefail
trap 'echo "[ERROR] Failed at line $LINENO" >&2' ERR

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
cd "$PROJECT_ROOT"

hostname
printf 'PBS_JOBID=%s\n' "${PBS_JOBID:-unknown}"
"$PYTHON_BIN" - <<'PY'
import platform
import sys

import pytest
import torch

print(f"python={sys.version.split()[0]}")
print(f"platform={platform.platform()}")
print(f"pytest={pytest.__version__}")
print(f"torch={torch.__version__}")
PY

"$PYTHON_BIN" -m pytest -q \
  tests/test_plan03_support.py \
  tests/reference/test_plan03_classic_static_oracle.py \
  tests/test_plan03_p0_red.py

"$PYTHON_BIN" -m pytest -q

printf 'PLAN03_PHASE0_TESTS_COMPLETE=%s\n' "${PBS_JOBID:-unknown}"
