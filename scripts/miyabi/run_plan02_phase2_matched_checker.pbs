#!/bin/bash
#PBS -N fsdiloco_p2_matched_check
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:00:20
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] Phase 2 matched checker failed at line $LINENO" >&2' ERR

: "${PHASE2_STATIC_RUN_ROOT:?PHASE2_STATIC_RUN_ROOT is required}"
: "${PHASE2_DYNAMIC_RUN_ROOT:?PHASE2_DYNAMIC_RUN_ROOT is required}"
: "${PHASE2_MATCHED_RECEIPTS:?PHASE2_MATCHED_RECEIPTS is required}"
: "${PHASE2_MATCHED_OUTPUT:?PHASE2_MATCHED_OUTPUT is required}"
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
cd "$PROJECT_ROOT"

"$PYTHON_BIN" -m fs_diloco.tools.phase2_matched_evidence \
  --static-run-root "$PHASE2_STATIC_RUN_ROOT" \
  --dynamic-run-root "$PHASE2_DYNAMIC_RUN_ROOT" \
  --receipts "$PHASE2_MATCHED_RECEIPTS" \
  --output "$PHASE2_MATCHED_OUTPUT"
