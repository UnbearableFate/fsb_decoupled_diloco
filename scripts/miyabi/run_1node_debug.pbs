#!/bin/bash
#PBS -q regular-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
trap 'echo "[ERROR] Failed at line $LINENO" >&2' ERR

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
CONFIG="${CONFIG:-$PROJECT_ROOT/configs/fs_diloco_gpt2_wikitext2_1l_debug.yaml}"
RUN_ID="${RUN_ID:-$(date +%Y%m%d_%H%M%S)_fs_diloco_1node_debug}"
SHARED_ROOT="${SHARED_ROOT:-$PROJECT_ROOT/runs/fs_diloco/$RUN_ID}"
SYNCER_DB_DIR="${SYNCER_DB_DIR:-${TMPDIR:-/tmp}/fs_diloco/$RUN_ID}"
CACHE_ROOT="${CACHE_ROOT:-$PROJECT_ROOT/.cache/fs_diloco}"
HF_HOME="${HF_HOME:-$CACHE_ROOT/huggingface}"
HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$HF_HOME/datasets}"
HF_HUB_CACHE="${HF_HUB_CACHE:-$HF_HOME/hub}"
HF_DATASETS_OFFLINE="${HF_DATASETS_OFFLINE:-0}"
HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-0}"
FS_DILOCO_HF_WIKITEXT_REPO="${FS_DILOCO_HF_WIKITEXT_REPO:-Salesforce/wikitext}"
SYNCER_CUDA_VISIBLE_DEVICES="${SYNCER_CUDA_VISIBLE_DEVICES:-0}"
LEARNER_CUDA_VISIBLE_DEVICES="${LEARNER_CUDA_VISIBLE_DEVICES:-0}"
NUM_LEARNERS=1

cd "$PROJECT_ROOT"
mkdir -p "$SHARED_ROOT" "$PROJECT_ROOT/logs" "$HF_DATASETS_CACHE" "$HF_HUB_CACHE"
LOG_ROOT="$PROJECT_ROOT/logs/qsub_${RUN_ID}"
mkdir -p "$LOG_ROOT"

echo "RUN_ID=$RUN_ID"
echo "PROJECT_ROOT=$PROJECT_ROOT"
echo "CONFIG=$CONFIG"
echo "SHARED_ROOT=$SHARED_ROOT"
echo "SYNCER_DB_DIR=$SYNCER_DB_DIR"
echo "SYNCER_CUDA_VISIBLE_DEVICES=$SYNCER_CUDA_VISIBLE_DEVICES"
echo "LEARNER_CUDA_VISIBLE_DEVICES=$LEARNER_CUDA_VISIBLE_DEVICES"
echo "PBS_JOBID=${PBS_JOBID:-}"
echo "PBS_NODEFILE=${PBS_NODEFILE:-}"
echo "HOST=$(hostname)"

CUDA_VISIBLE_DEVICES="$SYNCER_CUDA_VISIBLE_DEVICES" \
HF_HOME="$HF_HOME" HF_DATASETS_CACHE="$HF_DATASETS_CACHE" HF_HUB_CACHE="$HF_HUB_CACHE" \
HF_DATASETS_OFFLINE="$HF_DATASETS_OFFLINE" HF_HUB_OFFLINE="$HF_HUB_OFFLINE" \
FS_DILOCO_HF_WIKITEXT_REPO="$FS_DILOCO_HF_WIKITEXT_REPO" \
"$PYTHON_BIN" -m fs_diloco.syncer \
  --config "$CONFIG" \
  --run-id "$RUN_ID" \
  --shared-root "$SHARED_ROOT" \
  --sqlite-local-dir "$SYNCER_DB_DIR" \
  --num-learners "$NUM_LEARNERS" \
  > "$LOG_ROOT/syncer.log" 2>&1 &
syncer_pid=$!

sleep 5

CUDA_VISIBLE_DEVICES="$LEARNER_CUDA_VISIBLE_DEVICES" \
HF_HOME="$HF_HOME" HF_DATASETS_CACHE="$HF_DATASETS_CACHE" HF_HUB_CACHE="$HF_HUB_CACHE" \
HF_DATASETS_OFFLINE="$HF_DATASETS_OFFLINE" HF_HUB_OFFLINE="$HF_HUB_OFFLINE" \
FS_DILOCO_HF_WIKITEXT_REPO="$FS_DILOCO_HF_WIKITEXT_REPO" \
"$PYTHON_BIN" -m fs_diloco.learner \
  --config "$CONFIG" \
  --run-id "$RUN_ID" \
  --shared-root "$SHARED_ROOT" \
  --learner-id learner_000 \
  --num-learners "$NUM_LEARNERS" \
  > "$LOG_ROOT/learner_000.log" 2>&1 &
learner_pid=$!

wait "$learner_pid"
wait "$syncer_pid"

"$PYTHON_BIN" -m fs_diloco.analysis "$SHARED_ROOT" --json > "$LOG_ROOT/summary.json"
cat "$LOG_ROOT/summary.json"
