#!/bin/bash
#PBS -q regular-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
trap 'echo "[ERROR] Failed at line $LINENO" >&2' ERR

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
CONFIG="${CONFIG:-$PROJECT_ROOT/configs/fs_diloco_gpt2_wikitext2_1l_debug.yaml}"
RUN_ID="${RUN_ID:-$(date +%Y%m%d_%H%M%S)_fs_diloco_1node_debug}"
SHARED_ROOT="${SHARED_ROOT:-$PROJECT_ROOT/runs/fs_diloco/$RUN_ID}"
SYNCER_DB_DIR="${SYNCER_DB_DIR:-${TMPDIR:-/tmp}/fs_diloco/$RUN_ID}"
SYNCER_CUDA_VISIBLE_DEVICES="${SYNCER_CUDA_VISIBLE_DEVICES:-0}"
LEARNER_CUDA_VISIBLE_DEVICES="${LEARNER_CUDA_VISIBLE_DEVICES:-0}"
NUM_LEARNERS=1

cd "$PROJECT_ROOT"
mkdir -p "$SHARED_ROOT" "$PROJECT_ROOT/logs"
LOG_ROOT="$PROJECT_ROOT/logs/qsub_${RUN_ID}"
mkdir -p "$LOG_ROOT"

echo "RUN_ID=$RUN_ID"
echo "PROJECT_ROOT=$PROJECT_ROOT"
echo "CONFIG=$CONFIG"
echo "SHARED_ROOT=$SHARED_ROOT"
echo "SYNCER_DB_DIR=$SYNCER_DB_DIR"
echo "SYNCER_CUDA_VISIBLE_DEVICES=$SYNCER_CUDA_VISIBLE_DEVICES"
echo "LEARNER_CUDA_VISIBLE_DEVICES=$LEARNER_CUDA_VISIBLE_DEVICES"
echo "HOST=$(hostname)"

CUDA_VISIBLE_DEVICES="$SYNCER_CUDA_VISIBLE_DEVICES" "$PYTHON_BIN" -m fs_diloco.syncer \
  --config "$CONFIG" \
  --run-id "$RUN_ID" \
  --shared-root "$SHARED_ROOT" \
  --sqlite-local-dir "$SYNCER_DB_DIR" \
  --num-learners "$NUM_LEARNERS" \
  > "$LOG_ROOT/syncer.log" 2>&1 &
syncer_pid=$!

sleep 5

CUDA_VISIBLE_DEVICES="$LEARNER_CUDA_VISIBLE_DEVICES" "$PYTHON_BIN" -m fs_diloco.learner \
  --config "$CONFIG" \
  --run-id "$RUN_ID" \
  --shared-root "$SHARED_ROOT" \
  --learner-id learner_000 \
  --num-learners "$NUM_LEARNERS" \
  > "$LOG_ROOT/learner_000.log" 2>&1 &
learner_pid=$!

wait "$learner_pid"
wait "$syncer_pid"

"$PYTHON_BIN" -m fs_diloco.analysis "$SHARED_ROOT" --json > "$LOG_ROOT/summary.json"
cat "$LOG_ROOT/summary.json"
