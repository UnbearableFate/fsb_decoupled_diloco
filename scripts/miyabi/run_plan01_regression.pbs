#!/bin/bash
#PBS -N fsdiloco_plan01_regression
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:20:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] Failed at line $LINENO" >&2' ERR

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PRIMARY_WORKTREE_ROOT="${PRIMARY_WORKTREE_ROOT:-/work/xg24i002/x10041/fsb_decoupled_diloco}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
RUN_ID="${RUN_ID:-plan01_regression_${PBS_JOBID%%.*}}"
RUN_ROOT="${RUN_ROOT:-$PRIMARY_WORKTREE_ROOT/runs/fs_diloco/$RUN_ID}"

cd "$PROJECT_ROOT"
"$PYTHON_BIN" -m pytest -q

PRIMARY_WORKTREE_ROOT="$PRIMARY_WORKTREE_ROOT" \
SHARED_ROOT="$RUN_ROOT" \
RUN_ID="$RUN_ID" \
FS_DILOCO_ALLOW_DIRTY_SNAPSHOT=1 \
bash scripts/local/run_tiny_2proc_smoke.sh

"$PYTHON_BIN" - "$RUN_ROOT" <<'PY'
import json
import sqlite3
import sys
from pathlib import Path

run_root = Path(sys.argv[1])
summary = json.loads((run_root / "control/summary.json").read_text(encoding="utf-8"))
assert summary["authority"] == "full_protocol_v4"
assert summary["all_learners_stopped"] is True
connection = sqlite3.connect(run_root / "control/syncer_metadata.sqlite3")
connection.row_factory = sqlite3.Row
try:
    assert connection.execute("PRAGMA integrity_check").fetchone()[0] == "ok"
    terminal = connection.execute("SELECT * FROM terminal_state").fetchone()
    assert terminal is not None and terminal["state"] == "finalized"
    assert summary["final_version"] == terminal["final_version"]
    fences = connection.execute(
        "SELECT state, hard_crash_gap_tokens_upper_bound FROM terminal_contributor_fences"
    ).fetchall()
    assert len(fences) == 2
    assert {row["state"] for row in fences} == {"acked"}
    assert sum(row["hard_crash_gap_tokens_upper_bound"] for row in fences) == 0
finally:
    connection.close()
attestations = list((run_root / "metrics/attestations").glob("*/*/*.json"))
telemetry = list((run_root / "metrics").glob("learner/*/*.jsonl"))
telemetry += list((run_root / "metrics").glob("syncer/*/*.jsonl"))
assert len(attestations) == 3
assert len(telemetry) == 3
assert not list((run_root / "metrics").glob("*.csv"))
print({"run_root": str(run_root), "summary": summary, "telemetry_files": len(telemetry)})
PY
