#!/bin/bash
#PBS -N fsdiloco_p6_g5
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:20:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] P6 G5 tiny scenarios failed at line $LINENO" >&2' ERR
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
export PYTHONDONTWRITEBYTECODE=1
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
RUNS_ROOT="${RUNS_ROOT:-$PROJECT_ROOT/runs/fs_diloco}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
: "${EVIDENCE_OUTPUT:?EVIDENCE_OUTPUT is required}"
: "${TMPDIR:?TMPDIR is required}"

cd "$PROJECT_ROOT"
"$PYTHON_BIN" scripts/miyabi/plan03_p6_tiny_scenarios.py \
  --project-root "$PROJECT_ROOT" \
  --runs-root "$RUNS_ROOT" \
  --temp-root "$TMPDIR" \
  --output "$EVIDENCE_OUTPUT"
