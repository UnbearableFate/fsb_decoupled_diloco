#!/bin/bash
#PBS -N fsdiloco_launch
#PBS -q regular-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] independent launcher failed at line $LINENO" >&2' ERR

: "${RUN_ID:?RUN_ID is required}"
: "${SHARED_ROOT:?SHARED_ROOT is required}"
: "${LOG_ROOT:?LOG_ROOT is required}"
: "${ACTOR_QUEUE:?ACTOR_QUEUE is required}"
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
CONFIG="${CONFIG:-$PROJECT_ROOT/configs/full_protocol.yaml}"
SYNCER_WALLTIME="${SYNCER_WALLTIME:-00:10:00}"
LEARNER_WALLTIME="${LEARNER_WALLTIME:-00:10:00}"

cd "$PROJECT_ROOT"
test -x "$PYTHON_BIN"
exec "$PYTHON_BIN" -m fs_diloco.tools.launch_independent_run \
  --config "$CONFIG" \
  --run-id "$RUN_ID" \
  --shared-root "$SHARED_ROOT" \
  --project-root "$PROJECT_ROOT" \
  --submit \
  --actor-queue "$ACTOR_QUEUE" \
  --syncer-walltime "$SYNCER_WALLTIME" \
  --learner-walltime "$LEARNER_WALLTIME" \
  --log-root "$LOG_ROOT"
