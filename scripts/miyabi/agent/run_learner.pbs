#!/bin/bash
#PBS -N fsdiloco_learner
#PBS -q regular-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] learner failed at line $LINENO" >&2' ERR

: "${FS_DILOCO_SHARED_ROOT:?FS_DILOCO_SHARED_ROOT is required}"
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
DESCRIPTOR="$FS_DILOCO_SHARED_ROOT/control/run_descriptor.json"

source "$PROJECT_ROOT/scripts/miyabi/agent/actor_identity.sh"
prepare_actor_identity "$DESCRIPTOR" "$PROJECT_ROOT" "$PYTHON_BIN"
cd "$PROJECT_ROOT"

authorization=()
if [[ "$FS_DILOCO_MEMBERSHIP_MODE" == "static" ]]; then
  : "${LEARNER_INDEX:?LEARNER_INDEX is required}"
  printf -v LEARNER_ID 'learner_%03d' "$LEARNER_INDEX"
  STATIC_JOB_ID="${PBS_JOBID%%.*}"
  LOGICAL_LAUNCH_ID="${FS_DILOCO_STATIC_LAUNCH_PREFIX:-static}-${STATIC_JOB_ID}-${LEARNER_ID}"
  authorization=(--learner-id "$LEARNER_ID" --logical-launch-id "$LOGICAL_LAUNCH_ID")
else
  if [[ -n "${FS_DILOCO_LAUNCH_REQUEST_ID:-}" ]]; then
    : "${FS_DILOCO_STREAM_ID:?FS_DILOCO_STREAM_ID is required for a replacement launch}"
    authorization=(
      --launch-request-id "$FS_DILOCO_LAUNCH_REQUEST_ID"
      --stream-id "$FS_DILOCO_STREAM_ID"
    )
    if [[ -n "${FS_DILOCO_REPLACE_INSTANCE_ID:-}" ]]; then
      authorization+=(--replace-instance-id "$FS_DILOCO_REPLACE_INSTANCE_ID")
    fi
  else
    : "${BOOTSTRAP_SLOT:?BOOTSTRAP_SLOT is required}"
    authorization=(--bootstrap-slot "$BOOTSTRAP_SLOT")
  fi
fi

exec "$PYTHON_BIN" -m fs_diloco.learner \
  --config "$FS_DILOCO_RESOLVED_CONFIG" \
  --shared-root "$FS_DILOCO_SHARED_ROOT" \
  "${authorization[@]}"
