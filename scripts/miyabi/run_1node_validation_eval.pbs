#!/bin/bash
#PBS -N fsdiloco_valeval
#PBS -q regular-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
trap 'echo "[ERROR] Failed at line $LINENO" >&2' ERR
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
RUN_ROOT="${RUN_ROOT:?RUN_ROOT must identify a completed training run}"
CHECKPOINT="${CHECKPOINT:-}"
CONFIG="${CONFIG:-}"
VALIDATION_OUTPUT="${VALIDATION_OUTPUT:-}"
VALIDATION_DEVICE="${VALIDATION_DEVICE:-auto}"
VALIDATION_DTYPE="${VALIDATION_DTYPE:-bfloat16}"
VALIDATION_BATCH_SIZE="${VALIDATION_BATCH_SIZE:-4}"
VALIDATION_MAX_BLOCKS="${VALIDATION_MAX_BLOCKS:-}"
ALLOW_NON_LATEST="${ALLOW_NON_LATEST:-false}"
VALIDATION_TERMINAL_PREDECESSOR="${VALIDATION_TERMINAL_PREDECESSOR:-false}"
ALLOW_MISSING_SOURCE_IDENTITY="${ALLOW_MISSING_SOURCE_IDENTITY:-false}"
CACHE_ROOT="${CACHE_ROOT:-$PROJECT_ROOT/.cache/fs_diloco}"
HF_HOME="${HF_HOME:-$CACHE_ROOT/huggingface}"
HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$HF_HOME/datasets}"
HF_HUB_CACHE="${HF_HUB_CACHE:-$HF_HOME/hub}"
TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-false}"
CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

cd "$PROJECT_ROOT"
if [[ ! -x "$PYTHON_BIN" ]]; then
  echo "Python executable not found or not executable: $PYTHON_BIN" >&2
  exit 2
fi
if [[ ! -f "$RUN_ROOT/control/summary.json" ]]; then
  echo "Training summary is missing: $RUN_ROOT/control/summary.json" >&2
  exit 2
fi

mkdir -p "$RUN_ROOT/metrics" "$RUN_ROOT/logs" "$HF_DATASETS_CACHE" "$HF_HUB_CACHE"
EVALUATOR_IDENTITY_JSON="$RUN_ROOT/metrics/validation_evaluator_source_identity.json"
EVALUATOR_IDENTITY_ENV="$RUN_ROOT/metrics/validation_evaluator_source_identity.env"
"$PYTHON_BIN" "$PROJECT_ROOT/scripts/miyabi/capture_source_identity.py" \
  --project-root "$PROJECT_ROOT" \
  --output-json "$EVALUATOR_IDENTITY_JSON" \
  --output-env "$EVALUATOR_IDENTITY_ENV"
source "$EVALUATOR_IDENTITY_ENV"

export CUDA_VISIBLE_DEVICES HF_HOME HF_DATASETS_CACHE HF_HUB_CACHE TOKENIZERS_PARALLELISM
ARGS=(
  -m fs_diloco.tools.validation_eval
  --project-root "$PROJECT_ROOT"
  --run-root "$RUN_ROOT"
  --device "$VALIDATION_DEVICE"
  --dtype "$VALIDATION_DTYPE"
  --batch-size "$VALIDATION_BATCH_SIZE"
)
if [[ -n "$VALIDATION_OUTPUT" ]]; then
  ARGS+=(--output "$VALIDATION_OUTPUT")
fi
if [[ -n "$CHECKPOINT" ]]; then
  ARGS+=(--checkpoint "$CHECKPOINT")
fi
if [[ -n "$CONFIG" ]]; then
  ARGS+=(--config "$CONFIG")
fi
if [[ -n "$VALIDATION_MAX_BLOCKS" ]]; then
  ARGS+=(--max-blocks "$VALIDATION_MAX_BLOCKS")
fi
case "${ALLOW_NON_LATEST,,}" in
  1|true|yes|on) ARGS+=(--allow-non-latest) ;;
  0|false|no|off) ;;
  *) echo "Invalid ALLOW_NON_LATEST=$ALLOW_NON_LATEST" >&2; exit 2 ;;
esac
case "${VALIDATION_TERMINAL_PREDECESSOR,,}" in
  1|true|yes|on) ARGS+=(--terminal-predecessor) ;;
  0|false|no|off) ;;
  *) echo "Invalid VALIDATION_TERMINAL_PREDECESSOR=$VALIDATION_TERMINAL_PREDECESSOR" >&2; exit 2 ;;
esac
case "${ALLOW_MISSING_SOURCE_IDENTITY,,}" in
  1|true|yes|on) ARGS+=(--allow-missing-source-identity) ;;
  0|false|no|off) ;;
  *) echo "Invalid ALLOW_MISSING_SOURCE_IDENTITY=$ALLOW_MISSING_SOURCE_IDENTITY" >&2; exit 2 ;;
esac

echo "RUN_ROOT=$RUN_ROOT"
echo "CHECKPOINT=${CHECKPOINT:-<latest>}"
echo "VALIDATION_OUTPUT=${VALIDATION_OUTPUT:-<role-default>}"
echo "VALIDATION_DEVICE=$VALIDATION_DEVICE"
echo "VALIDATION_DTYPE=$VALIDATION_DTYPE"
echo "VALIDATION_BATCH_SIZE=$VALIDATION_BATCH_SIZE"
echo "EVALUATOR_SOURCE_FINGERPRINT=$FS_DILOCO_SOURCE_FINGERPRINT"
"$PYTHON_BIN" "${ARGS[@]}" 2>&1 | tee "$RUN_ROOT/logs/validation_eval.log"

VALIDATION_RESULT_PATH="${VALIDATION_OUTPUT:-$RUN_ROOT/metrics/validation_eval.json}"
if [[ -z "$VALIDATION_OUTPUT" && "${VALIDATION_TERMINAL_PREDECESSOR,,}" =~ ^(1|true|yes|on)$ ]]; then
  mapfile -t predecessor_results < <(
    find "$RUN_ROOT/metrics" -maxdepth 1 -type f \
      -name 'validation_terminal_predecessor_v*.json' | sort
  )
  if [[ "${#predecessor_results[@]}" -eq 0 ]]; then
    echo "Terminal predecessor validation result was not created" >&2
    exit 2
  fi
  VALIDATION_RESULT_PATH="${predecessor_results[-1]}"
fi

"$PYTHON_BIN" -c '
import json, math, pathlib, sys
path = pathlib.Path(sys.argv[1])
payload = json.loads(path.read_text(encoding="utf-8"))
assert payload.get("status") == "success"
assert int(payload.get("block_count", 0)) > 0
assert int(payload.get("predicted_tokens", 0)) > 0
assert math.isfinite(float(payload["validation_loss"]))
assert math.isfinite(float(payload["validation_perplexity"]))
print(json.dumps({key: payload[key] for key in ("status", "validation_loss", "validation_perplexity", "predicted_tokens", "block_count", "checkpoint_sha256")}, sort_keys=True))
' "$VALIDATION_RESULT_PATH"
