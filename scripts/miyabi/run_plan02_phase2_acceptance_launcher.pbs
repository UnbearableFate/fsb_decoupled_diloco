#!/bin/bash
#PBS -N fsdiloco_p2_launch
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:00:20
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] Phase 2 acceptance launcher failed at line $LINENO" >&2' ERR

: "${PHASE2_ACCEPTANCE_KIND:?PHASE2_ACCEPTANCE_KIND is required}"
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
REPORT_ROOT="$PROJECT_ROOT/reports/DOING/fsb_decoupled_diloco_plan_02"
STAMP="${STAMP:-$(date +%Y%m%d-%H%M%S)}"
RUN_ID="${RUN_ID:-plan02_phase2_${PHASE2_ACCEPTANCE_KIND}_${PBS_JOBID%%.*}}"
SHARED_ROOT="${SHARED_ROOT:-$PROJECT_ROOT/runs/fs_diloco/$RUN_ID}"
CONFIG="$PROJECT_ROOT/configs/fs_diloco_tiny_ha_dynamic_${PHASE2_ACCEPTANCE_KIND/g8/2node}.yaml"
if [[ "$PHASE2_ACCEPTANCE_KIND" == "g9" ]]; then
  CONFIG="$PROJECT_ROOT/configs/fs_diloco_tiny_ha_dynamic_acceptance.yaml"
fi
IDENTITY_ROOT="${TMPDIR:?TMPDIR is required}/plan02_p2_acceptance_identity"
PENDING="$REPORT_ROOT/artifacts/${STAMP}_phase2-${PHASE2_ACCEPTANCE_KIND}-launch_review.json"
PASSED="$REPORT_ROOT/artifacts/${STAMP}_phase2-${PHASE2_ACCEPTANCE_KIND}-launch_pass.json"
EVIDENCE="$REPORT_ROOT/artifacts/${STAMP}_phase2-${PHASE2_ACCEPTANCE_KIND}_pass.json"

cd "$PROJECT_ROOT"
mkdir -p "$REPORT_ROOT/artifacts"
"$PYTHON_BIN" scripts/miyabi/capture_source_identity.py \
  --project-root "$PROJECT_ROOT" \
  --output-json "$IDENTITY_ROOT.json" \
  --output-env "$IDENTITY_ROOT.env"
source "$IDENTITY_ROOT.env"

init_args=()
if [[ "${ALLOW_DIRTY_SNAPSHOT:-0}" == "1" ]]; then
  init_args+=(--allow-dirty-snapshot)
fi
"$PYTHON_BIN" -m fs_diloco.tools.init_run \
  --config "$CONFIG" \
  --run-id "$RUN_ID" \
  --shared-root "$SHARED_ROOT" \
  --project-root "$PROJECT_ROOT" \
  "${init_args[@]}" \
  > "$REPORT_ROOT/artifacts/${STAMP}_phase2-${PHASE2_ACCEPTANCE_KIND}-init_pass.json"

readarray -t DESCRIPTOR_IDENTITY < <($PYTHON_BIN - "$SHARED_ROOT/control/run_descriptor.json" <<'PY'
import json
import sys
d = json.load(open(sys.argv[1], encoding="utf-8"))
print(d["descriptor_sha256"])
print(d["source_fingerprint"])
print(d["resolved_config_sha256"])
PY
)
DESCRIPTOR_SHA="${DESCRIPTOR_IDENTITY[0]}"
SOURCE_FINGERPRINT="${DESCRIPTOR_IDENTITY[1]}"
CONFIG_SHA="${DESCRIPTOR_IDENTITY[2]}"

"$PYTHON_BIN" -m fs_diloco.tools.launch_phase2_acceptance \
  --kind "$PHASE2_ACCEPTANCE_KIND" \
  --project-root "$PROJECT_ROOT" \
  --run-id "$RUN_ID" \
  --shared-root "$SHARED_ROOT" \
  --descriptor-sha256 "$DESCRIPTOR_SHA" \
  --source-fingerprint "$SOURCE_FINGERPRINT" \
  --config-sha256 "$CONFIG_SHA" \
  --launcher-job-id "${PBS_JOBID:-}" \
  --crash-walltime "${CRASH_WALLTIME:-00:00:15}" \
  --syncer-walltime "${SYNCER_WALLTIME:-00:02:30}" \
  --learner-walltime "${LEARNER_WALLTIME:-00:02:00}" \
  --checker-walltime "${CHECKER_WALLTIME:-00:00:20}" \
  --pending-artifact "$PENDING" \
  --pass-artifact "$PASSED" \
  --evidence-artifact "$EVIDENCE"

printf 'PHASE2_RUN_ROOT=%s\nPHASE2_LAUNCH_ARTIFACT=%s\nPHASE2_EVIDENCE=%s\n' \
  "$SHARED_ROOT" "$PASSED" "$EVIDENCE"
