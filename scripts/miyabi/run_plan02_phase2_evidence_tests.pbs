#!/bin/bash
#PBS -N fsdiloco_p2_evidence
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:01:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] Phase 2 evidence tests failed at line $LINENO" >&2' ERR
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat

: "${EVIDENCE_KIND:?EVIDENCE_KIND is required}"
: "${EVIDENCE_OUTPUT:?EVIDENCE_OUTPUT is required}"
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
IDENTITY_ROOT="${TMPDIR:?TMPDIR is required}/plan02_p2_test_identity"
cd "$PROJECT_ROOT"

hostname
printf 'PBS_JOBID=%s\nPBS_NODEFILE=%s\nPROJECT_ROOT=%s\n' \
  "${PBS_JOBID:-}" "${PBS_NODEFILE:-}" "$PROJECT_ROOT"
module list 2>&1 | cat
"$PYTHON_BIN" scripts/miyabi/capture_source_identity.py \
  --project-root "$PROJECT_ROOT" \
  --output-json "$IDENTITY_ROOT.json" \
  --output-env "$IDENTITY_ROOT.env"
source "$IDENTITY_ROOT.env"

"$PYTHON_BIN" -m fs_diloco.tools.phase2_test_evidence \
  --kind "$EVIDENCE_KIND" \
  --project-root "$PROJECT_ROOT" \
  --git-commit "$FS_DILOCO_GIT_COMMIT" \
  --source-fingerprint "$FS_DILOCO_SOURCE_FINGERPRINT" \
  --output "$EVIDENCE_OUTPUT"
