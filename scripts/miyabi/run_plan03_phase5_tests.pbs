#!/bin/bash
#PBS -N fsdiloco_plan03_p5
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] Failed at line $LINENO" >&2' ERR

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
export PYTHONDONTWRITEBYTECODE=1
export CUDA_VISIBLE_DEVICES=""
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
RUFF_BIN="${RUFF_BIN:-$PROJECT_ROOT/.venv/bin/ruff}"
TEST_TARGET="${TEST_TARGET:-tests/architecture tests/legacy tests/tools/test_authorize_static_replacement.py tests/runtime/test_p4_mandatory_runtime.py tests/storage tests/test_config.py tests/test_torch_baseline_artifacts_and_data.py tests/test_torch_baseline_health.py tests/test_torch_baseline_protocol.py tests/test_fragment_analysis.py tests/test_validation_eval.py}"
RUN_FULL_SUITE="${RUN_FULL_SUITE:-1}"
cd "$PROJECT_ROOT"

hostname
printf 'PBS_JOBID=%s\n' "${PBS_JOBID:-unknown}"
printf 'TEST_TARGET=%s\n' "$TEST_TARGET"

read -r -a targets <<<"$TEST_TARGET"
"$RUFF_BIN" check fs_diloco tests scripts/miyabi
"$RUFF_BIN" format --check \
  fs_diloco/baselines/protocol.py \
  fs_diloco/core/config.py \
  fs_diloco/core/config_v4.py \
  fs_diloco/legacy/config_v1_v3.py \
  fs_diloco/legacy/fragment_v0.py \
  fs_diloco/legacy/reader.py \
  fs_diloco/modeling/training.py \
  fs_diloco/protocol/merge.py \
  fs_diloco/runtime/learner_entrypoint.py \
  fs_diloco/runtime/learner_v4.py \
  fs_diloco/runtime/syncer_entrypoint.py \
  fs_diloco/runtime/syncer_v4.py \
  fs_diloco/storage/admission.py \
  fs_diloco/storage/control.py \
  fs_diloco/storage/leader_lease.py \
  fs_diloco/storage/paths.py \
  fs_diloco/storage/run_initializer.py \
  fs_diloco/tools/analysis.py \
  fs_diloco/tools/authorize_static_replacement.py \
  fs_diloco/tools/eval_lm_harness.py \
  fs_diloco/tools/publish_quality_gate.py \
  fs_diloco/tools/validation_eval.py \
  scripts/miyabi/build_plan03_p5_test_accounting.py \
  scripts/miyabi/check_plan03.py \
  tests/architecture/test_p5_removed_runtime.py \
  tests/legacy/test_legacy_v1_v3_reader.py \
  tests/runtime/test_p4_mandatory_runtime.py \
  tests/test_config.py \
  tests/test_fragment_analysis.py \
  tests/test_inner_scheduler.py \
  tests/test_plan03_checker.py \
  tests/test_validation_eval.py \
  tests/tools/test_authorize_static_replacement.py
"$PYTHON_BIN" scripts/miyabi/check_plan03.py \
  --root "$PROJECT_ROOT" \
  --expect reports/DOING/fsb_decoupled_diloco_plan_03_unified_ha/artifacts/20260808-223500_p0-runtime-surface-inventory_review.json \
  --verify-p5-contracts \
  --inventory-output "${TMPDIR:?TMPDIR is required}/p5-current-boundary.json"
"$PYTHON_BIN" -m pytest -q "${targets[@]}"
if [[ "$RUN_FULL_SUITE" == "1" ]]; then
  "$PYTHON_BIN" -m pytest -q
fi

printf 'PLAN03_PHASE5_TESTS_COMPLETE=%s\n' "${PBS_JOBID:-unknown}"
