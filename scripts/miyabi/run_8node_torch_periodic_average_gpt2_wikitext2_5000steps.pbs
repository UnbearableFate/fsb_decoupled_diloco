#!/bin/bash
#PBS -N torch_pavg_gpt2_5k
#PBS -q regular-g
#PBS -W group_list=xg24i002
#PBS -l select=8:mpiprocs=1
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
trap 'echo "[ERROR] Failed at line $LINENO" >&2' ERR
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
REQUIRED_MODULES=()
for module_name in "${REQUIRED_MODULES[@]}"; do
  module load "$module_name"
done
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PRIMARY_WORKTREE_ROOT="${PRIMARY_WORKTREE_ROOT:-/work/xg24i002/x10041/fsb_decoupled_diloco}"
PYTHON_BIN="${PYTHON_BIN:-$PRIMARY_WORKTREE_ROOT/.venv/bin/python}"
PYTHONPATH="$PROJECT_ROOT"
CONFIG="${CONFIG:-$PROJECT_ROOT/configs/torch_baseline_gpt2_wikitext2_8n_5000steps.yaml}"
MODE=periodic_average
RUN_ID="${RUN_ID:-$(date +%Y%m%d_%H%M%S)_torch_periodic_average_gpt2_wikitext2_8n_5k}"
SHARED_ROOT="${SHARED_ROOT:-$PRIMARY_WORKTREE_ROOT/runs/torch_baselines/$RUN_ID}"
CACHE_ROOT="${CACHE_ROOT:-$PRIMARY_WORKTREE_ROOT/.cache/fs_diloco}"
HF_HOME="${HF_HOME:-$CACHE_ROOT/huggingface}"
HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$HF_HOME/datasets}"
HF_HUB_CACHE="${HF_HUB_CACHE:-$HF_HOME/hub}"
HF_DATASETS_OFFLINE="${HF_DATASETS_OFFLINE:-0}"
HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-0}"
FS_DILOCO_HF_WIKITEXT_REPO="${FS_DILOCO_HF_WIKITEXT_REPO:-Salesforce/wikitext}"
WANDB_MODE="${WANDB_MODE:-online}"
TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-false}"
OMP_NUM_THREADS="${OMP_NUM_THREADS:-8}"
CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
NPROC_PER_NODE=1
DIST_BACKEND=nccl
RDZV_ID="${RDZV_ID:-${PBS_JOBID:-manual}_${MODE}}"

: "${PBS_NODEFILE:?PBS_NODEFILE is not set}"
cd "$PROJECT_ROOT"
if [[ ! -x "$PYTHON_BIN" ]]; then
  echo "Python executable not found: $PYTHON_BIN" >&2
  exit 2
fi
mapfile -t HOSTS < <(awk '!seen[$0]++' "$PBS_NODEFILE")
NNODES="${#HOSTS[@]}"
if [[ "$NNODES" -ne 8 ]]; then
  echo "Expected 8 distinct PBS nodes, got $NNODES" >&2
  printf '%s\n' "${HOSTS[@]}" >&2
  exit 2
fi
WORLD_SIZE=$((NNODES * NPROC_PER_NODE))
MASTER_ADDR="${MASTER_ADDR:-${HOSTS[0]}}"
if [[ -z "${MASTER_PORT:-}" ]]; then
  job_number="${PBS_JOBID%%.*}"
  if [[ "$job_number" =~ ^[0-9]+$ ]]; then
    MASTER_PORT=$((20000 + job_number % 20000))
  else
    MASTER_PORT=29500
  fi
fi

if [[ -e "$SHARED_ROOT/training_manifest.json" ]] || \
  compgen -G "$SHARED_ROOT/metrics/rank_*.csv" >/dev/null; then
  echo "Refusing to overwrite existing torch baseline run: $SHARED_ROOT" >&2
  exit 2
fi
mkdir -p "$SHARED_ROOT" "$PRIMARY_WORKTREE_ROOT/logs" "$HF_DATASETS_CACHE" "$HF_HUB_CACHE"
LOG_ROOT="$PRIMARY_WORKTREE_ROOT/logs/qsub_${RUN_ID}"
mkdir -p "$LOG_ROOT"
SOURCE_IDENTITY_JSON="$SHARED_ROOT/source_identity.json"
SOURCE_IDENTITY_ENV="$SHARED_ROOT/source_identity.env"
"$PYTHON_BIN" "$PROJECT_ROOT/scripts/miyabi/capture_source_identity.py" \
  --project-root "$PROJECT_ROOT" \
  --output-json "$SOURCE_IDENTITY_JSON" \
  --output-env "$SOURCE_IDENTITY_ENV" | tee "$LOG_ROOT/source_identity.log"
source "$SOURCE_IDENTITY_ENV"
if [[ "$FS_DILOCO_GIT_DIRTY" != 0 ]]; then
  echo "Formal torch baseline requires a clean source commit" >&2
  exit 2
fi

MPI_ENV_ARGS=(
  "PROJECT_ROOT=$PROJECT_ROOT"
  "PYTHON_BIN=$PYTHON_BIN"
  "PYTHONPATH=$PYTHONPATH"
  "CONFIG=$CONFIG"
  "MODE=$MODE"
  "RUN_ID=$RUN_ID"
  "SHARED_ROOT=$SHARED_ROOT"
  "MASTER_ADDR=$MASTER_ADDR"
  "MASTER_PORT=$MASTER_PORT"
  "RDZV_ID=$RDZV_ID"
  "NNODES=$NNODES"
  "NPROC_PER_NODE=$NPROC_PER_NODE"
  "DIST_BACKEND=$DIST_BACKEND"
  "HF_HOME=$HF_HOME"
  "HF_DATASETS_CACHE=$HF_DATASETS_CACHE"
  "HF_HUB_CACHE=$HF_HUB_CACHE"
  "HF_DATASETS_OFFLINE=$HF_DATASETS_OFFLINE"
  "HF_HUB_OFFLINE=$HF_HUB_OFFLINE"
  "FS_DILOCO_HF_WIKITEXT_REPO=$FS_DILOCO_HF_WIKITEXT_REPO"
  "WANDB_MODE=$WANDB_MODE"
  "TOKENIZERS_PARALLELISM=$TOKENIZERS_PARALLELISM"
  "OMP_NUM_THREADS=$OMP_NUM_THREADS"
  "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
  "FS_DILOCO_GIT_COMMIT=$FS_DILOCO_GIT_COMMIT"
  "FS_DILOCO_GIT_DIRTY=$FS_DILOCO_GIT_DIRTY"
  "FS_DILOCO_SOURCE_FINGERPRINT=$FS_DILOCO_SOURCE_FINGERPRINT"
  "FS_DILOCO_REQUIRE_SOURCE_IDENTITY=$FS_DILOCO_REQUIRE_SOURCE_IDENTITY"
)

echo "PBS_JOBID=${PBS_JOBID:-}"
echo "MODE=$MODE RUN_ID=$RUN_ID"
echo "PROJECT_ROOT=$PROJECT_ROOT"
echo "CONFIG=$CONFIG"
echo "SHARED_ROOT=$SHARED_ROOT"
echo "NNODES=$NNODES WORLD_SIZE=$WORLD_SIZE NPROC_PER_NODE=$NPROC_PER_NODE"
echo "MASTER_ADDR=$MASTER_ADDR MASTER_PORT=$MASTER_PORT RDZV_ID=$RDZV_ID"
echo "BACKEND=$DIST_BACKEND CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
echo "SOURCE_FINGERPRINT=$FS_DILOCO_SOURCE_FINGERPRINT"
printf 'HOST %s\n' "${HOSTS[@]}"

TRAIN_ARGS=(
  --config "$CONFIG"
  --mode "$MODE"
  --run-id "$RUN_ID"
  --shared-root "$SHARED_ROOT"
)

mpirun \
  --mca mpi_abort_print_stack 1 \
  --report-bindings \
  --map-by ppr:1:node \
  --bind-to none \
  -np "$NNODES" \
  /usr/bin/env "${MPI_ENV_ARGS[@]}" \
  bash -lc '
    set -eEuo pipefail
    node_rank="${OMPI_COMM_WORLD_RANK:?OMPI_COMM_WORLD_RANK is not set}"
    echo "torchrun supervisor host=$(hostname) node_rank=${node_rank}/${NNODES}"
    exec "$PYTHON_BIN" -m torch.distributed.run \
      --rdzv-backend=c10d \
      --rdzv-endpoint="${MASTER_ADDR}:${MASTER_PORT}" \
      --rdzv-id="$RDZV_ID" \
      --nnodes="$NNODES" \
      --nproc-per-node="$NPROC_PER_NODE" \
      --node-rank="$node_rank" \
      --max-restarts=0 \
      -m fs_diloco.baselines.train "$@"
  ' bash "${TRAIN_ARGS[@]}" 2>&1 | tee "$LOG_ROOT/train.log"

"$PYTHON_BIN" "$PROJECT_ROOT/scripts/miyabi/check_torch_baseline_health.py" \
  --run-root "$SHARED_ROOT" \
  --mode "$MODE" \
  --expected-world-size 8 \
  --target-step 200 | tee "$LOG_ROOT/final_health.json"
