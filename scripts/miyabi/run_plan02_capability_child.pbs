#!/bin/bash
#PBS -N fsdiloco_p02_cap_child
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:02:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] Failed at line $LINENO" >&2' ERR

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
module list 2>&1 | cat

: "${PLAN02_PROBE_ROOT:?PLAN02_PROBE_ROOT is not set}"
: "${PLAN02_REQUEST_FINGERPRINT:?PLAN02_REQUEST_FINGERPRINT is not set}"
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
ARRAY_INDEX="${PBS_ARRAY_INDEX:-scalar}"
OUTPUT_PATH="$PLAN02_PROBE_ROOT/child_${PLAN02_REQUEST_FINGERPRINT}_${ARRAY_INDEX}.json"

"$PYTHON_BIN" - \
  "$OUTPUT_PATH" \
  "$PLAN02_REQUEST_FINGERPRINT" \
  "${PBS_JOBID:-}" \
  "${PBS_JOBNAME:-}" \
  "$ARRAY_INDEX" <<'PY'
import json
import os
from pathlib import Path
import sys
import tempfile
import time

output = Path(sys.argv[1])
payload = {
    "artifact_format_version": 1,
    "request_fingerprint": sys.argv[2],
    "pbs_job_id": sys.argv[3],
    "job_name": sys.argv[4],
    "array_index": sys.argv[5],
    "hostname": os.uname().nodename,
    "written_at": time.time(),
}
output.parent.mkdir(parents=True, exist_ok=True)
descriptor, temporary = tempfile.mkstemp(prefix=f".{output.name}.", dir=output.parent)
with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
    json.dump(payload, handle, indent=2, sort_keys=True)
    handle.write("\n")
    handle.flush()
    os.fsync(handle.fileno())
os.replace(temporary, output)
PY

test -s "$OUTPUT_PATH"
printf 'PLAN02_CAPABILITY_CHILD_COMPLETE=%s\n' "$OUTPUT_PATH"
