#!/bin/bash
#PBS -N fsdiloco_p1_launch
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:02:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] Phase 1 acceptance launcher failed at line $LINENO" >&2' ERR

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
RUN_ID="${RUN_ID:-plan02_phase1_acceptance_${PBS_JOBID%%.*}}"
SHARED_ROOT="${SHARED_ROOT:-$PROJECT_ROOT/runs/fs_diloco/$RUN_ID}"
CONFIG="$PROJECT_ROOT/configs/fs_diloco_tiny_ha_static_acceptance.yaml"
REPORT_ROOT="$PROJECT_ROOT/reports/DOING/fsb_decoupled_diloco_plan_02"
STAMP="${STAMP:-$(date +%Y%m%d-%H%M%S)}"
ARTIFACT="$REPORT_ROOT/artifacts/${STAMP}_phase1-independent-launch_pass.json"
PENDING_ARTIFACT="$REPORT_ROOT/artifacts/${STAMP}_phase1-independent-launch_review.json"
INIT_STDOUT="$REPORT_ROOT/artifacts/${STAMP}_phase1-init-run_pass.json"
IDENTITY_ROOT="${TMPDIR:?TMPDIR is required}/plan02_p1_acceptance_identity"
CRASH_WALLTIME="${CRASH_WALLTIME:-00:00:20}"
SUCCESSOR_WALLTIME="${SUCCESSOR_WALLTIME:-00:00:45}"
LEARNER_WALLTIME="${LEARNER_WALLTIME:-00:00:45}"

cd "$PROJECT_ROOT"
mkdir -p "$REPORT_ROOT/artifacts"
"$PYTHON_BIN" scripts/miyabi/capture_source_identity.py \
  --project-root "$PROJECT_ROOT" \
  --output-json "$IDENTITY_ROOT.json" \
  --output-env "$IDENTITY_ROOT.env"
source "$IDENTITY_ROOT.env"

"$PYTHON_BIN" -m fs_diloco.tools.init_run \
  --config "$CONFIG" \
  --run-id "$RUN_ID" \
  --shared-root "$SHARED_ROOT" \
  --project-root "$PROJECT_ROOT" \
  > "$INIT_STDOUT"

DESCRIPTOR_SHA="$($PYTHON_BIN - "$SHARED_ROOT/control/run_descriptor.json" <<'PY'
import json
import sys
print(json.load(open(sys.argv[1], encoding="utf-8"))["descriptor_sha256"])
PY
)"
"$PYTHON_BIN" -m fs_diloco.tools.launch_phase1_acceptance \
  --project-root "$PROJECT_ROOT" \
  --run-id "$RUN_ID" \
  --shared-root "$SHARED_ROOT" \
  --descriptor-sha256 "$DESCRIPTOR_SHA" \
  --launcher-job-id "${PBS_JOBID:-}" \
  --crash-walltime "$CRASH_WALLTIME" \
  --successor-walltime "$SUCCESSOR_WALLTIME" \
  --learner-walltime "$LEARNER_WALLTIME" \
  --pending-artifact "$PENDING_ARTIFACT" \
  --pass-artifact "$ARTIFACT"

printf 'PLAN02_PHASE1_LAUNCH_ARTIFACT=%s\n' "$ARTIFACT"
