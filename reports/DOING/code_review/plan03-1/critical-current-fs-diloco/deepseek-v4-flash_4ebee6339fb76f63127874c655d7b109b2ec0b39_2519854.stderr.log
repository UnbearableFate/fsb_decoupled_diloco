[build-system]
requires = ["setuptools>=78"]
build-backend = "setuptools.build_meta"

[project]
name = "fs-diloco-miyabi"
version = "0.1.0"
description = "Filesystem-backed Decoupled DiLoCo prototype for Miyabi"
readme = "README.md"
requires-python = ">=3.10"
dependencies = [
    "torch",
    "transformers",
    "datasets",
    "safetensors",
    "pyyaml",
]

[project.optional-dependencies]
dev = [
    "hypothesis>=6.100",
    "pytest",
    "pytest-timeout>=2.3",
    "ruff",
]

[project.scripts]
fs-diloco = "fs_diloco.cli:main"
fs-diloco-syncer = "fs_diloco.syncer:main"
fs-diloco-learner = "fs_diloco.learner:main"
fs-diloco-init-run = "fs_diloco.tools.init_run:main"
fs-diloco-launch-run = "fs_diloco.tools.launch_independent_run:main"
fs-diloco-inspect = "fs_diloco.tools.analysis:main"

[tool.ruff]
line-length = 100
target-version = "py313"

[tool.pytest.ini_options]
addopts = "--strict-markers"
pythonpath = ["."]
timeout = 300
timeout_method = "thread"
xfail_strict = true
markers = [
    "state_machine: bounded generated protocol state-machine validation",
    "crash_matrix: deterministic publication crash-point validation",
    "integration: multi-component or real pipeline validation",
    "performance: paired performance or boundedness measurement",
]

[tool.setuptools.package-data]
"fs_diloco.storage" = ["schema.sql", "schema_dynamic.sql"]

[tool.setuptools.packages.find]
include = ["fs_diloco*"]

[tool.uv]
prerelease = "allow"

[tool.uv.sources]
torch = { index = "pytorch-cu132" }

[[tool.uv.index]]
name = "pytorch-cu132"
url = "https://download.pytorch.org/whl/cu132"
explicit = true
