CONFIG="${CONFIG:-$PROJECT_ROOT/configs/full_protocol_static.yaml}"
RUN_ID="${RUN_ID:-full_protocol_${PBS_JOBID%%.*}}"
SHARED_ROOT="${SHARED_ROOT:-$PRIMARY_WORKTREE_ROOT/runs/full_protocol/$RUN_ID}"
LOG_ROOT="${LOG_ROOT:-$PRIMARY_WORKTREE_ROOT/logs/qsub_${RUN_ID}}"
EXPECTED_NODES="${EXPECTED_NODES:-9}"
NUM_LEARNERS="${NUM_LEARNERS:-8}"
EXPECTED_INNER_STEPS="${EXPECTED_INNER_STEPS:-50}"
EXPECTED_GLOBAL_STEPS="${EXPECTED_GLOBAL_STEPS:-10}"
readonly SYNCER_TAKEOVER_BOUNDARY_VERSION=2
SYNCER_CUDA_VISIBLE_DEVICES="${SYNCER_CUDA_VISIBLE_DEVICES:-0}"
LEARNER_CUDA_VISIBLE_DEVICES="${LEARNER_CUDA_VISIBLE_DEVICES:-0}"
[[ ! -e "$EVIDENCE_OUTPUT" ]] || {
  echo "EVIDENCE_OUTPUT already exists: $EVIDENCE_OUTPUT" >&2
  exit 2
}

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
module list 2>&1 | cat
export PROJECT_ROOT PRIMARY_WORKTREE_ROOT PYTHON_BIN CONFIG RUN_ID SHARED_ROOT LOG_ROOT
export EXPECTED_NODES NUM_LEARNERS
export SYNCER_TAKEOVER_BOUNDARY_VERSION
export SYNCER_CUDA_VISIBLE_DEVICES LEARNER_CUDA_VISIBLE_DEVICES
export FS_DILOCO_FAULT_SCENARIO="${FS_DILOCO_FAULT_SCENARIO:-none}"

checker=(
  "$PYTHON_BIN" "$PROJECT_ROOT/scripts/miyabi/check_full_protocol_run.py"
  --gate "$GATE"
  --experiment-id "$EXPERIMENT_ID"
  --requirement-id "$REQUIREMENT_ID"
  --project-root "$PROJECT_ROOT"
  --run-root "$SHARED_ROOT"
  --log-root "$LOG_ROOT"
  --expected-global-steps "$EXPECTED_GLOBAL_STEPS"
  --expected-inner-steps "$EXPECTED_INNER_STEPS"
  --expected-contributors "$NUM_LEARNERS"
  --expected-hosts "$EXPECTED_NODES"
  --fault-scenario "$FS_DILOCO_FAULT_SCENARIO"
  --syncer-takeover-boundary-version "$SYNCER_TAKEOVER_BOUNDARY_VERSION"
  --output "$EVIDENCE_OUTPUT"
)

publish_blocked_on_exit() {
  local exit_status=$?
  trap - EXIT
  if [[ "$exit_status" -ne 0 && ! -e "$EVIDENCE_OUTPUT" ]]; then
    "${checker[@]}" \
      --blocked-reason \
      "Full Protocol execution exited before gate evidence publication (exit=$exit_status)" \
      || true
  fi
  exit "$exit_status"
}
trap publish_blocked_on_exit EXIT

bash "$PROJECT_ROOT/scripts/miyabi/run_full_protocol_allocation.sh"
"${checker[@]}"
