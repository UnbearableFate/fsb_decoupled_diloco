#!/bin/bash
#PBS -N plan04_format_archive
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] plan04 source formatting failed at line $LINENO" >&2' ERR

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
cd "$PROJECT_ROOT"

"$PROJECT_ROOT/.venv/bin/python" -m ruff format \
  fs_diloco/core/config.py \
  fs_diloco/runtime/adoption.py \
  fs_diloco/runtime/learner.py \
  fs_diloco/runtime/learner_control.py \
  fs_diloco/runtime/services/__init__.py \
  fs_diloco/runtime/services/terminal.py \
  fs_diloco/runtime/syncer.py \
  tests/harness/test_plan04_experiment.py \
  tests/runtime/test_learner_control.py \
  tests/runtime/test_terminal_service.py \
  tests/test_adoption_strategy.py \
  tests/test_config.py
"$PROJECT_ROOT/.venv/bin/python" -m ruff check --fix \
  fs_diloco/core/config.py \
  fs_diloco/runtime/adoption.py \
  fs_diloco/runtime/learner.py \
  fs_diloco/runtime/learner_control.py \
  fs_diloco/runtime/services/__init__.py \
  fs_diloco/runtime/services/terminal.py \
  fs_diloco/runtime/syncer.py \
  tests/harness/test_plan04_experiment.py \
  tests/runtime/test_learner_control.py \
  tests/runtime/test_terminal_service.py \
  tests/test_adoption_strategy.py \
  tests/test_config.py
