#!/bin/bash
#PBS -N plan04_archive_oracle
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] archive-aware diagnostic oracle failed at line $LINENO" >&2' ERR

: "${RUN_ROOT:?RUN_ROOT is required}"
: "${FIRST_SYNCER_JOB_ID:?FIRST_SYNCER_JOB_ID is required}"
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
export PYTHONPATH="$PROJECT_ROOT"
cd "$PROJECT_ROOT"

exec "$PROJECT_ROOT/.venv/bin/python" \
  "$PROJECT_ROOT/reports/DOING/plan04/validate_diagnostic_authority.py" \
  "$RUN_ROOT" \
  "$FIRST_SYNCER_JOB_ID"
