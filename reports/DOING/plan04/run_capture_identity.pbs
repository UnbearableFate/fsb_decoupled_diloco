#!/bin/bash
#PBS -N plan04_identity
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] plan04 source identity capture failed at line $LINENO" >&2' ERR

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
OUTPUT_JSON="${OUTPUT_JSON:-$PROJECT_ROOT/reports/DOING/plan04/artifacts/final_source_identity.json}"
OUTPUT_ENV="${OUTPUT_ENV:-$PROJECT_ROOT/reports/DOING/plan04/artifacts/final_source_identity.env}"
cd "$PROJECT_ROOT"

exec "$PYTHON_BIN" "$PROJECT_ROOT/scripts/miyabi/agent/capture_source_identity.py" \
  --project-root "$PROJECT_ROOT" \
  --output-json "$OUTPUT_JSON" \
  --output-env "$OUTPUT_ENV"
