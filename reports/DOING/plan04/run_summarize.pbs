#!/bin/bash
#PBS -N plan04_summary
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] plan04 summary failed at line $LINENO" >&2' ERR

: "${BASELINE_DDP:?BASELINE_DDP is required}"
: "${BASELINE_PERIODIC:?BASELINE_PERIODIC is required}"
: "${DYNAMIC_RUN:?DYNAMIC_RUN is required}"
: "${OUTPUT_CSV:?OUTPUT_CSV is required}"
: "${COMPARISON_OUTPUT:?COMPARISON_OUTPUT is required}"

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
cd "$PROJECT_ROOT"

exec "$PYTHON_BIN" "$PROJECT_ROOT/tools/summarize_runs.py" \
  "$BASELINE_DDP" \
  "$BASELINE_PERIODIC" \
  "$DYNAMIC_RUN" \
  --output "$OUTPUT_CSV" \
  --comparison-output "$COMPARISON_OUTPUT"
