#!/bin/bash
#PBS -N plan04_verify_bench
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] payload verification benchmark failed at line $LINENO" >&2' ERR

: "${RUN_ROOT:?RUN_ROOT is required}"
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
cd "$PROJECT_ROOT"

exec "$PROJECT_ROOT/.venv/bin/python" \
  "$PROJECT_ROOT/reports/DOING/plan04/benchmark_payload_verify.py" \
  "$RUN_ROOT"
