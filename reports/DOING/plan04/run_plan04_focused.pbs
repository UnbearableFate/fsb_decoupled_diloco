#!/bin/bash
#PBS -N plan04_focused
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] plan04 focused tests failed at line $LINENO" >&2' ERR

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
cd "$PROJECT_ROOT"

"$PYTHON_BIN" -m pytest -q \
  tests/runtime/test_learner_control.py \
  tests/runtime/test_terminal_service.py \
  tests/runtime/test_syncer_composition.py \
  tests/test_adoption_strategy.py \
  tests/storage/test_object_store.py \
  tests/storage/test_audit_archive.py \
  tests/storage/test_proposal_adjudication.py \
  tests/torch_ddp_baselines \
  tests/harness/test_plan04_experiment.py \
  tests/test_capture_source_identity.py \
  tests/test_config.py \
  tests/test_summarize_runs.py
