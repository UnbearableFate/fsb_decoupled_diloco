#!/bin/bash
#PBS -N torch_baseline_5000
#PBS -q regular-g
#PBS -W group_list=xg24i002
#PBS -l select=8:mpiprocs=1
#PBS -l walltime=00:40:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
trap 'echo "[ERROR] Standalone torch baseline failed at line $LINENO" >&2' ERR

: "${MODE:?MODE must be ddp or periodic_average}"
case "$MODE" in
  ddp|periodic_average) ;;
  *)
    echo "Unsupported MODE: $MODE" >&2
    exit 2
    ;;
esac

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$PWD}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
PYTHONPATH="$PROJECT_ROOT"
CONFIG="${CONFIG:-$PROJECT_ROOT/torch_ddp_baselines/configs/gpt2_wikitext2_8n_5000steps.yaml}"
RUN_ID="${RUN_ID:-$(date +%Y%m%d_%H%M%S)_torch_${MODE}_gpt2_wikitext2_8n_5000}"
RUN_ROOT="${RUN_ROOT:-$PROJECT_ROOT/runs/torch_ddp_baselines/$RUN_ID}"
LOG_ROOT="${LOG_ROOT:-$PROJECT_ROOT/logs/torch_ddp_baselines/$RUN_ID}"
CACHE_ROOT="${CACHE_ROOT:-$PROJECT_ROOT/.cache/torch_ddp_baselines}"
HF_HOME="${HF_HOME:-$CACHE_ROOT/huggingface}"
HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$HF_HOME/datasets}"
HF_HUB_CACHE="${HF_HUB_CACHE:-$HF_HOME/hub}"
HF_DATASETS_OFFLINE="${HF_DATASETS_OFFLINE:-0}"
HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-0}"
TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-false}"
OMP_NUM_THREADS="${OMP_NUM_THREADS:-8}"
WORKER_CUDA_VISIBLE_DEVICES="${WORKER_CUDA_VISIBLE_DEVICES:-0}"
NPROC_PER_NODE=1
RDZV_ID="${RDZV_ID:-${PBS_JOBID:-manual}_${MODE}}"

: "${PBS_NODEFILE:?PBS_NODEFILE is not set}"
cd "$PROJECT_ROOT"
if [[ ! -x "$PYTHON_BIN" ]]; then
  echo "Python executable not found: $PYTHON_BIN" >&2
  exit 2
fi
if [[ ! -f "$CONFIG" ]]; then
  echo "Baseline config not found: $CONFIG" >&2
  exit 2
fi
source_status="$(
  git status --porcelain --untracked-files=all -- \
    fs_diloco tools torch_ddp_baselines pyproject.toml
)"
if [[ -n "$source_status" ]]; then
  echo "Standalone baseline sources must be committed before submission:" >&2
  printf '%s\n' "$source_status" >&2
  exit 2
fi
TORCH_BASELINE_GIT_COMMIT="$(git rev-parse HEAD)"

mapfile -t HOSTS < <(awk '!seen[$0]++' "$PBS_NODEFILE")
NNODES="${#HOSTS[@]}"
if [[ "$NNODES" -ne 8 ]]; then
  echo "Expected 8 distinct PBS nodes, got $NNODES" >&2
  printf '%s\n' "${HOSTS[@]}" >&2
  exit 2
fi
WORLD_SIZE=$((NNODES * NPROC_PER_NODE))
if [[ -z "${MASTER_ADDR:-}" ]]; then
  resolved_master_addr="$(getent ahostsv4 "${HOSTS[0]}" | awk 'NR == 1 {print $1; exit}' || true)"
  MASTER_ADDR="${resolved_master_addr:-${HOSTS[0]}}"
fi
if [[ -z "${MASTER_PORT:-}" ]]; then
  job_number="${PBS_JOBID%%.*}"
  if [[ "$job_number" =~ ^[0-9]+$ ]]; then
    MASTER_PORT=$((20000 + job_number % 20000))
  else
    MASTER_PORT=29500
  fi
fi

if [[ -e "$RUN_ROOT/training_manifest.json" ]] || \
  compgen -G "$RUN_ROOT/metrics/rank_*.csv" >/dev/null; then
  echo "Refusing to overwrite existing baseline run: $RUN_ROOT" >&2
  exit 2
fi
mkdir -p "$RUN_ROOT" "$LOG_ROOT" "$HF_DATASETS_CACHE" "$HF_HUB_CACHE"

MPI_ENV_ARGS=(
  "PYTHON_BIN=$PYTHON_BIN"
  "PYTHONPATH=$PYTHONPATH"
  "CONFIG=$CONFIG"
  "MODE=$MODE"
  "RUN_ID=$RUN_ID"
  "RUN_ROOT=$RUN_ROOT"
  "MASTER_ADDR=$MASTER_ADDR"
  "MASTER_PORT=$MASTER_PORT"
  "RDZV_ID=$RDZV_ID"
  "NNODES=$NNODES"
  "NPROC_PER_NODE=$NPROC_PER_NODE"
  "HF_HOME=$HF_HOME"
  "HF_DATASETS_CACHE=$HF_DATASETS_CACHE"
  "HF_HUB_CACHE=$HF_HUB_CACHE"
  "HF_DATASETS_OFFLINE=$HF_DATASETS_OFFLINE"
  "HF_HUB_OFFLINE=$HF_HUB_OFFLINE"
  "TOKENIZERS_PARALLELISM=$TOKENIZERS_PARALLELISM"
  "OMP_NUM_THREADS=$OMP_NUM_THREADS"
  "WORKER_CUDA_VISIBLE_DEVICES=$WORKER_CUDA_VISIBLE_DEVICES"
  "TORCH_BASELINE_GIT_COMMIT=$TORCH_BASELINE_GIT_COMMIT"
)

echo "PBS_JOBID=${PBS_JOBID:-} MODE=$MODE RUN_ID=$RUN_ID"
echo "PROJECT_ROOT=$PROJECT_ROOT CONFIG=$CONFIG"
echo "RUN_ROOT=$RUN_ROOT LOG_ROOT=$LOG_ROOT"
echo "NNODES=$NNODES WORLD_SIZE=$WORLD_SIZE NPROC_PER_NODE=$NPROC_PER_NODE"
echo "MASTER_ADDR=$MASTER_ADDR MASTER_PORT=$MASTER_PORT RDZV_ID=$RDZV_ID"
echo "WORKER_CUDA_VISIBLE_DEVICES=$WORKER_CUDA_VISIBLE_DEVICES"
echo "TORCH_BASELINE_GIT_COMMIT=$TORCH_BASELINE_GIT_COMMIT"
printf 'HOST %s\n' "${HOSTS[@]}"

TRAIN_ARGS=(
  --config "$CONFIG"
  --mode "$MODE"
  --run-id "$RUN_ID"
  --run-root "$RUN_ROOT"
)

mpirun \
  --mca mpi_abort_print_stack 1 \
  --report-bindings \
  --map-by ppr:1:node \
  --bind-to none \
  -np "$NNODES" \
  /usr/bin/env "${MPI_ENV_ARGS[@]}" \
  bash -lc '
    set -eEuo pipefail
    node_rank="${OMPI_COMM_WORLD_RANK:?OMPI_COMM_WORLD_RANK is not set}"
    export CUDA_VISIBLE_DEVICES="$WORKER_CUDA_VISIBLE_DEVICES"
    echo "torchrun supervisor host=$(hostname) node_rank=${node_rank}/${NNODES} CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}"
    exec "$PYTHON_BIN" -m torch.distributed.run \
      --rdzv-backend=c10d \
      --rdzv-endpoint="${MASTER_ADDR}:${MASTER_PORT}" \
      --rdzv-id="$RDZV_ID" \
      --nnodes="$NNODES" \
      --nproc-per-node="$NPROC_PER_NODE" \
      --node-rank="$node_rank" \
      --max-restarts=0 \
      -m torch_ddp_baselines "$@"
  ' bash "${TRAIN_ARGS[@]}" 2>&1 | tee "$LOG_ROOT/train.log"

"$PYTHON_BIN" -m torch_ddp_baselines.health \
  --run-root "$RUN_ROOT" \
  --mode "$MODE" | tee "$LOG_ROOT/final_health.json"

(
  flock -x 9
  "$PYTHON_BIN" "$PROJECT_ROOT/tools/summarize_runs.py" \
    "$RUN_ROOT" \
    --output "$PROJECT_ROOT/runs/summary.csv"
) 9>"$PROJECT_ROOT/runs/.summary.lock"
